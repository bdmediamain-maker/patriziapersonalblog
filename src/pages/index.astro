<script>
  // Video hero: prima hls.js (MSE), HLS nativo solo come ripiego (iOS).
  // Alcuni browser dichiarano "maybe" per l'HLS nativo ma poi non lo riproducono,
  // quindi canPlayType non è affidabile come primo test.
  const video = document.querySelector<HTMLVideoElement>("video[data-hls]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (video && !reduce) {
    const src = video.dataset.hls as string;
    const play = () => video.play().catch(() => {});
    // Il browser può rimandare l'autoplay se la scheda è in background: riprova.
    video.addEventListener("canplay", play, { once: true });
    document.addEventListener("visibilitychange", () => {
      if (!document.hidden && video.paused) play();
    });
    import("hls.js").then(({ default: Hls }) => {
      if (Hls.isSupported()) {
        const hls = new Hls({ enableWorker: false, capLevelToPlayerSize: true });
        hls.loadSource(src);
        hls.attachMedia(video);
        hls.on(Hls.Events.MANIFEST_PARSED, play);
      } else if (video.canPlayType("application/vnd.apple.mpegurl")) {
        video.src = src;
        video.addEventListener("loadedmetadata", play, { once: true });
      }
    });
  }
</script>

