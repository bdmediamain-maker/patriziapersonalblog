---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import ChapterHero from "../components/ChapterHero.astro";
import SkillGroup from "../components/SkillGroup.astro";
import CardFan from "../components/CardFan.astro";
import { aree } from "../data/aree";

// ── Dati ──────────────────────────────────────────────────────

// Video della hero (stream HLS indicato nel brief, ospitato su Mux).
const HERO_STREAM =
  "https://stream.mux.com/tLkHO1qZoaaQOUeVWo8hEBeGQfySP02EPS02BmnNFyXys.m3u8";

const stack = [
  "Oracle",
  "SQL Server",
  "PostgreSQL",
  "MongoDB",
  "MySQL / MariaDB",
  "IBM Db2",
  "Linux",
  "Windows",
  "Oracle Cloud (OCI)",
  "Exadata",
  "Docker",
  "Kubernetes",
  "Ansible",
  "IBM AIX",
  "WebLogic",
  "CI/CD",
];

const competenze = [
  {
    title: "Database Administration",
    items: [
      "Oracle 12c / 18c / 19c",
      "Microsoft SQL Server",
      "PostgreSQL",
      "MongoDB",
      "IBM Db2",
      "MySQL / MariaDB",
    ],
  },
  {
    title: "Oracle & Enterprise",
    items: [
      "RMAN / RMAN Duplicate",
      "Data Pump (expdp / impdp)",
      "Security, CMU, Wallet",
      "AD / LDAP / Kerberos",
      "Unified Auditing, WebLogic",
      "Oracle Net / TNS, Listener",
    ],
  },
  {
    title: "Migration & Consolidation",
    items: [
      "Database Migration",
      "Production Refresh",
      "Database Consolidation",
      "Backup & Restore",
      "Assessment infrastrutturali",
      "Validazione post-migrazione",
    ],
  },
  {
    title: "Infrastructure",
    items: [
      "Linux / Red Hat / CentOS",
      "IBM AIX",
      "Bash / Shell scripting",
      "Networking / DNS",
      "Monitoring",
      "Runbook / Confluence",
    ],
  },
];

const flusso = [
  { k: "Assessment", d: "Analisi ambiente e criticità" },
  { k: "Planning", d: "Strategia e piano operativo" },
  { k: "Migration", d: "Migrazione e riallineamento" },
  { k: "Validation", d: "Collaudo e verifica" },
  { k: "Documentation", d: "Runbook e knowledge base" },
  { k: "Support", d: "Continuità e handover" },
];

const valori = [
  { name: "Competenza", body: "Formazione continua e specializzazione tecnica." },
  { name: "Affidabilità", body: "Responsabilità e continuità in ogni fase." },
  { name: "Collaborazione", body: "Squadra e condivisione tra professionisti." },
  { name: "Innovazione", body: "Nuove tecnologie con utilità concreta." },
  { name: "Crescita", body: "Crescere e far crescere gli altri." },
];

// Partner tecnologici del network.
const partner = [
  {
    name: "Castaldo Solutions",
    desc: "Partner tecnologico e system integrator in ambito AI full stack. Loro l'intelligenza artificiale, PGNetwork i database e le infrastrutture: Oracle, PostgreSQL e altro.",
    href: "https://www.castaldosolutions.it/",
    label: "castaldosolutions.it",
  },
  {
    name: "SARCTE",
    desc: "Consulenza e supporto IT su infrastrutture, sistemi, networking, cybersecurity e monitoring, con particolare attenzione all'affidabilità e alla continuità operativa. Progettazione, gestione ed evoluzione delle infrastrutture IT.",
    href: "https://sarcte.it",
    label: "sarcte.it",
  },
];

const stagioni = [
  { season: "Inverno", key: "Cambiamento", body: "Ridefinire la direzione." },
  { season: "Primavera", key: "Crescita", body: "Studio, formazione, nuovi progetti." },
  { season: "Estate", key: "Costruzione", body: "Progetti enterprise e nascita di PGNetwork." },
  { season: "Autunno", key: "Condivisione", body: "Restituire competenze e opportunità." },
];

// Oltre la tecnologia · attività complementari al percorso IT.
const interessi = [
  {
    title: "Real Estate Internazionale",
    meta: "Dubai · iAD",
    desc: "Partner immobiliare iAD sul mercato di Dubai.",
  },
  {
    title: "Innovazione & Cripto",
    meta: "DBM · Sibill",
    desc: "Collaboratrice DBM ed esploratrice di nuove tecnologie e criptovalute. Partner Sibill.",
    href: "https://sibill.com/referral-program/?referral_code=PATGARWYMD",
    cta: "Scopri Sibill",
  },
  {
    title: "Network & Partnership",
    meta: "Jet HR · Fly Airlines",
    desc: "Partner Jet HR e Fly Airlines, nel mio network di collaborazioni professionali.",
  },
  {
    title: "Trading & Mercati",
    meta: "Financial Education",
    desc: "Percorso di studio su analisi tecnica, metodo e gestione del rischio.",
  },
];

// Formazione sintetica · quattro categorie.
// NOTA: associazione dei riferimenti alle categorie da confermare col cliente.
const formazione = [
  {
    cat: "Technology & AI",
    desc: "Database, infrastrutture, cloud e AI applicata.",
    refs: ["Aggiornamento tecnico continuo"],
  },
  {
    cat: "Business",
    desc: "Gestione d'impresa, leadership e strategia.",
    refs: ["Davide Caiazzo", "Giacomo Freddi"],
  },
  {
    cat: "Marketing & Personal Branding",
    desc: "Comunicazione, brand personale e posizionamento.",
    refs: ["Valerio Di Gerolamo", "Gasparotto"],
  },
  {
    cat: "Financial Education",
    desc: "Investimenti, mercati e gestione del rischio.",
    refs: [
      "Alfio Bardolla",
      "Lux Trading Academy",
      "Giordi Locatelli",
      "Andrea Giudice · CGA University",
    ],
  },
];

// Journal: schede illustrate, ognuna con argomento chiaro e sintesi.
const journal = [
  {
    tag: "Database",
    title: "Cosa fa davvero un DBA",
    desc: "Dietro un database non ci sono solo tabelle: capire le esigenze, mappare le dipendenze, pianificare, ridurre i rischi di una migrazione e garantire continuità.",
    src: "/poster-dietro-database.jpg",
    alt: "Scheda: dietro un database non ci sono solo tabelle, il ruolo del DBA",
    w: 1024,
    h: 1536,
  },
  {
    tag: "Disaster Recovery",
    title: "RTO e RPO, spiegati semplice",
    desc: "Quanti dati puoi permetterti di perdere e per quanto tempo puoi restare fermo: le due metriche alla base di ogni piano di ripristino, con esempi concreti.",
    src: "/poster-rto-rpo.jpg",
    alt: "Scheda: RTO e RPO, le due metriche chiave del Disaster Recovery",
    w: 1254,
    h: 1254,
  },
  {
    tag: "Servizio",
    title: "Assessment database e infrastruttura",
    desc: "Analisi di performance e sicurezza su Oracle, PostgreSQL, MongoDB, MySQL e MariaDB, con report chiaro, raccomandazioni e supporto di secondo e terzo livello.",
    src: "/poster-summer-offer.jpg",
    alt: "Scheda: assessment di database e infrastrutture PGNetwork",
    w: 1254,
    h: 1254,
  },
  {
    tag: "Innovazione",
    title: "Bitcoin e mining: prima capire",
    desc: "Come funziona il mining, il ruolo della potenza di calcolo e perché dietro c'è un'infrastruttura reale. Prima di investire, scegli di capire.",
    src: "/poster-bitcoin-mining.jpg",
    alt: "Scheda: prima di investire scegli di capire, Bitcoin e mining",
    w: 1254,
    h: 1254,
  },
];

const ARROW = '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>';
---

<Base>
  <Nav />

  <main>
    <!-- ════════════════════════════════════════════════════════
         1 · HERO · PGNetwork servizi IT
         ════════════════════════════════════════════════════════ -->
    <section class="hero" aria-label="PGNetwork, servizi IT">
      <video
        class="hero__video"
        data-hls={HERO_STREAM}
        muted
        autoplay
        loop
        playsinline
        preload="none"
        aria-hidden="true"
      ></video>
      <div class="hero__shade" aria-hidden="true"></div>

      <div class="hero__inner">
        <p class="hero__badge" style="--d:0">PGNetwork · Servizi IT B2B</p>

        <h1 class="hero__title" style="--d:1">
          <span class="hero__line">Trasformiamo le</span>
          <span class="hero__line">competenze in</span>
          <span class="hero__line hero__line--gold">soluzioni.</span>
        </h1>

        <div class="hero__bottom" style="--d:2">
          <div class="hero__copy">
            <p class="hero__desc">
              Un network B2B di professionisti IT per aziende e partner: dallo
              sviluppo software ai database, dal cloud all'infrastruttura, fino
              a sicurezza e continuità operativa.
            </p>
            <div class="hero__actions">
              <a class="pill" href="/servizi">
                Scopri i servizi
                <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ARROW} />
              </a>
              <a class="hero__link" href="#contatti">Parliamo del tuo progetto</a>
            </div>
          </div>

          <a
            class="founder"
            data-tilt
            href="#chi-sono"
            aria-label="Chi sono: Patrizia Gardis, fondatrice di PGNetwork"
          >
            <span class="founder__head">
              <span class="founder__avatar" aria-hidden="true">
                <img
                  src="/patrizia-ritratto.jpg"
                  alt=""
                  width="1024"
                  height="1536"
                  decoding="async"
                />
              </span>
              <span>
                <span class="founder__label">Fondato da</span>
                <span class="founder__name">Patrizia Gardis</span>
                <span class="founder__role">Database &amp; Infrastructure Consultant</span>
              </span>
            </span>
            <span class="founder__stats">
              <span><strong>7+</strong> anni nell'IT enterprise</span>
              <span><strong>9</strong> aree di servizio IT</span>
            </span>
          </a>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════
         2 · STACK · nastro tecnologie
         ════════════════════════════════════════════════════════ -->
    <section class="stackbar" aria-label="Stack tecnologico">
      <div class="stackbar__inner">
        <span class="stackbar__label">Stack tecnologico</span>
        <div class="marquee">
          <ul class="marquee__track" role="list">
            {
              [...stack, ...stack].map((t, i) => (
                <li aria-hidden={i >= stack.length ? "true" : undefined}>{t}</li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════
         3 · CHI SONO (foto in apertura)
         ════════════════════════════════════════════════════════ -->
    <section class="section intro" id="chi-sono" aria-label="Chi sono">
      <div class="wrap intro__grid">
        <div class="intro__media reveal">
          <img
            src="/patrizia-ritratto.jpg"
            alt="Ritratto di Patrizia Gardis"
            width="1024"
            height="1536"
            loading="lazy"
            decoding="async"
          />
          <span class="intro__badge">Founder · PGNetwork</span>
        </div>

        <div class="intro__text">
          <ChapterHero
            eyebrow="CHI SONO"
            title="Mi chiamo Patrizia Gardis."
            size="72"
          />
          <p class="prose prose--big reveal">
            Lavoro nel settore IT da oltre sette anni. Sono
            <strong class="strong">donna, madre, professionista e
            imprenditrice</strong>, ma il mio percorso principale nasce nella
            <em class="accent">Database Administration</em> e nelle
            infrastrutture IT.
          </p>
          <p class="prose reveal">
            Sono cresciuta attraverso progetti sempre più complessi:
            dall'operatività quotidiana alla progettazione di soluzioni
            infrastrutturali, al consolidamento di ambienti enterprise e alla
            collaborazione con team multidisciplinari. Metodo, responsabilità e
            attenzione ai dettagli sono il filo che tiene insieme ogni
            esperienza.
          </p>

          <ul class="facts" role="list" data-stagger>
            <li data-tilt>
              <span class="facts__num">7+</span>
              <span class="facts__lab">anni nell'IT enterprise</span>
            </li>
            <li data-tilt>
              <span class="facts__num">DBA</span>
              <span class="facts__lab">Oracle, SQL Server, PostgreSQL, MongoDB</span>
            </li>
            <li data-tilt>
              <span class="facts__num">Founder</span>
              <span class="facts__lab">PGNetwork, network IT B2B</span>
            </li>
          </ul>

          <div class="intro__actions reveal">
            <a class="pill pill--ghost" href="/cv-patrizia-gardis.pdf" download>
              Scarica il CV
            </a>
            <a class="textlink" href="#percorso">Il mio percorso</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════
         4 · PGNETWORK · aree di servizio IT
         ════════════════════════════════════════════════════════ -->
    <section class="section pg" id="pgnetwork" aria-label="PGNetwork">
      <div class="wrap">
        <div class="pg__head">
          <ChapterHero
            eyebrow="PGNETWORK"
            title="Un network IT, tante competenze."
            size="72"
          />
          <div class="pg__intro">
            <p class="prose prose--lead reveal">
              PGNetwork nasce dalla mia esperienza nella Database
              Administration: un network di professionisti IT specializzati che
              lavorano in sinergia per offrire ad aziende e partner servizi
              strutturati, affidabili e continuativi.
            </p>
            <p class="prose reveal">
              È un progetto in crescita, non una grande società già
              strutturata: un modo di lavorare con metodo, sinergia e supporto
              continuo. Sono disponibile anche come
              <em class="accent">partner DBA per società di consulenza IT</em>,
              per estendere i loro team quando serve.
            </p>
          </div>
        </div>

        <div class="areas">
          <CardFan items={aree} start={1} />
        </div>

        <div class="pg__cta reveal">
          <a class="pill" href="/servizi">
            Tutti i servizi
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ARROW} />
          </a>
          <a class="textlink" href="#contatti">Richiedi una consulenza</a>
        </div>

        <ol class="values" role="list" data-stagger>
          {
            valori.map((v) => (
              <li class="value">
                <span class="value__name">{v.name}</span>
                <span class="value__body">{v.body}</span>
              </li>
            ))
          }
        </ol>

        <div class="partners reveal">
          <span class="label">Partner tecnologici</span>
          <p class="partners__intro">
            PGNetwork lavora in sinergia con partner specializzati, per coprire
            l'intera catena tecnologica: database, infrastrutture, AI e
            sicurezza.
          </p>
          <div class="partners__grid" data-stagger>
            {
              partner.map((p) => (
                <article class="partner" data-tilt>
                  <h3 class="partner__name">{p.name}</h3>
                  <p class="partner__desc">{p.desc}</p>
                  <a
                    class="partner__link"
                    href={p.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {p.label}
                  </a>
                </article>
              ))
            }
          </div>
        </div>
      </div>

      <div class="pg-quote">
        <div class="wrap wrap--narrow">
          <blockquote class="pg-quote__text reveal">
            Non amministriamo soltanto database. Trasformiamo la
            <em>complessità in valore</em>.
          </blockquote>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════
         5 · COMPETENZE
         ════════════════════════════════════════════════════════ -->
    <section class="section" id="competenze" aria-label="Competenze">
      <div class="wrap">
        <ChapterHero
          eyebrow="COMPETENZE"
          title="Il cuore tecnico: database e infrastrutture."
          size="72"
        />
        <p class="prose prose--lead reveal">
          Una specializzazione precisa: Database Administration e
          infrastrutture enterprise, dall'analisi iniziale fino alla
          documentazione e all'handover.
        </p>
        <div class="competenze__grid" data-stagger>
          {competenze.map((c) => <SkillGroup {...c} />)}
        </div>
      </div>

      <div class="wrap proof">
        <div class="proof__head reveal">
          <span class="label">Progetto recente</span>
          <h3 class="proof__title">Enterprise Database Consolidation</h3>
        </div>
        <ul class="proof__stats" role="list" data-stagger>
          <li data-tilt><span class="proof__num">~2</span><span class="proof__lab">mesi</span></li>
          <li data-tilt><span class="proof__num">3</span><span class="proof__lab">tecnologie core</span></li>
          <li data-tilt><span class="proof__num">Multi</span><span class="proof__lab">ambienti enterprise</span></li>
          <li data-tilt><span class="proof__num">6</span><span class="proof__lab">fasi di metodo</span></li>
        </ul>
        <p class="prose reveal">
          In circa due mesi ho partecipato al consolidamento e al riallineamento
          di molteplici ambienti database di un importante cliente enterprise,
          lavorando su tecnologie <em class="accent">Oracle, MongoDB e MySQL /
          MariaDB</em>.
        </p>
        <p class="prose reveal">
          Il progetto ha incluso assessment, pianificazione, refresh e
          migrazione degli ambienti, configurazioni di sicurezza, riallineamento
          delle dipendenze applicative, backup e restore, troubleshooting,
          collaudo e documentazione tecnica.
        </p>
        <ol class="flow reveal" aria-label="Fasi del progetto">
          {
            flusso.map((f) => (
              <li class="flow__step">
                <span class="flow__k">{f.k}</span>
                <span class="flow__d">{f.d}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════
         6 · JOURNAL · schede illustrate
         ════════════════════════════════════════════════════════ -->
    <section class="section journal" id="journal" aria-label="Journal">
      <div class="wrap">
        <div class="journal__head">
          <ChapterHero
            eyebrow="JOURNAL"
            title="Guide e approfondimenti IT."
            size="72"
          />
          <p class="prose prose--lead reveal">
            Schede brevi e visive su database, disaster recovery e innovazione:
            i concetti chiave spiegati in modo chiaro. Apri una scheda per
            leggerla a tutto schermo.
          </p>
        </div>

        <div class="jgrid" data-stagger>
          {
            journal.map((j) => (
              <article class="jcard" data-tilt>
                <button
                  type="button"
                  class="jcard__thumb"
                  data-zoom
                  aria-label={`Apri la scheda: ${j.title}`}
                >
                  <img
                    src={j.src}
                    alt={j.alt}
                    width={j.w}
                    height={j.h}
                    loading="lazy"
                    decoding="async"
                  />
                </button>
                <div class="jcard__body">
                  <span class="jcard__tag">{j.tag}</span>
                  <h3 class="jcard__title">{j.title}</h3>
                  <p class="jcard__desc">{j.desc}</p>
                  <button
                    type="button"
                    class="jcard__cta"
                    data-zoom
                    data-zoom-src={j.src}
                    data-zoom-alt={j.alt}
                  >
                    Apri la scheda
                    <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ARROW} />
                  </button>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════
         7 · IL PERCORSO (stagioni + approfondimenti personali)
         ════════════════════════════════════════════════════════ -->
    <section class="section" id="percorso" aria-label="Il percorso">
      <div class="wrap">
        <ChapterHero
          eyebrow="IL PERCORSO"
          title="Le stagioni di Patrizia."
          size="72"
        />
      </div>

      <div class="seasons">
        <div class="seasons__bg" aria-hidden="true"></div>
        <div class="seasons__content wrap seasons__grid" data-stagger>
          {
            stagioni.map((s) => (
              <article class="season reveal">
                <span class="season__name">{s.season}</span>
                <h3 class="season__key">{s.key}</h3>
                <p class="season__body">{s.body}</p>
              </article>
            ))
          }
        </div>
      </div>

      <div class="wrap disc-group">
        <details class="disc reveal">
          <summary class="disc__summary">
            <span class="disc__head">
              <span class="label">Il percorso</span>
              <span class="disc__title">Il punto di svolta</span>
            </span>
            <span class="disc__icon" aria-hidden="true"></span>
          </summary>
          <div class="disc__content">
            <blockquote class="svolta__quote">
              Anche le prove più difficili possono trasformarsi in occasioni di
              crescita.
            </blockquote>
            <p class="prose">
              Circa un anno fa la mia carriera ha attraversato un cambiamento
              importante. Quello che sembrava un momento di incertezza è
              diventato un'opportunità: ampliare le competenze, evolvere verso
              progettazione e responsabilità, e iniziare a costruire nuovi
              progetti, dalla nascita di PGNetwork allo sviluppo di un mio
              network professionale.
            </p>
          </div>
        </details>

        <details class="disc reveal">
          <summary class="disc__summary">
            <span class="disc__head">
              <span class="label">Vita privata</span>
              <span class="disc__title">Famiglia, passioni e missione</span>
            </span>
            <span class="disc__icon" aria-hidden="true"></span>
          </summary>
          <div class="disc__content">
            <div class="personal">
              <div class="personal__block">
                <span class="label">Famiglia</span>
                <p class="personal__line">
                  Tre figli: Nicole, Loris e Nicolas. La famiglia è una delle
                  mie motivazioni più grandi e mi ricorda ogni giorno perché
                  vale la pena crescere, studiare e costruire.
                </p>
              </div>
              <div class="personal__block">
                <span class="label">Passioni</span>
                <ul class="keywords" role="list">
                  <li>Danza</li>
                  <li>Canto</li>
                  <li>Viaggi</li>
                  <li>Fotografia</li>
                  <li>Moda</li>
                </ul>
                <p class="personal__line personal__line--sm">
                  Passioni che mi danno energia ed equilibrio. Di recente anche
                  un percorso come modella presso Identity Agency di Milano.
                </p>
              </div>
              <div class="personal__block">
                <span class="label">Missione</span>
                <p class="personal__line">
                  Un giorno, una scuola a Santo Domingo, il mio Paese d'origine,
                  per offrire ai giovani più possibilità di formazione e futuro.
                  Sostengo cause legate all'infanzia e all'educazione.
                </p>
              </div>
            </div>
          </div>
        </details>

        <details class="disc reveal">
          <summary class="disc__summary">
            <span class="disc__head">
              <span class="label">Oltre la tecnologia</span>
              <span class="disc__title">Progetti &amp; Interessi</span>
            </span>
            <span class="disc__icon" aria-hidden="true"></span>
          </summary>
          <div class="disc__content">
            <div class="cards">
              {
                interessi.map((r) => (
                  <article class="card" data-tilt>
                    <span class="card__meta">{r.meta}</span>
