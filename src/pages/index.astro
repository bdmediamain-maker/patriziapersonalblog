---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import ChapterHero from "../components/ChapterHero.astro";
import VerticalRow from "../components/VerticalRow.astro";
import TechChips from "../components/TechChips.astro";
import SkillGroup from "../components/SkillGroup.astro";
import PosterImage from "../components/PosterImage.astro";

// ── Dati ──────────────────────────────────────────────────────

const techMain = [
