// Valori professionali (sezione chiara, scroll sticky)
const valori = [
  {
    num: "01",
    name: "Competenza",
    body: "Formazione continua e specializzazione tecnica, come base di ogni progetto.",
  },
  {
    num: "02",
    name: "Affidabilità",
    body: "Responsabilità, continuità e attenzione al cliente in ogni fase del lavoro.",
  },
  {
    num: "03",
    name: "Collaborazione",
    body: "Credo nel lavoro di squadra e nella condivisione delle competenze tra professionisti.",
  },
  {
    num: "04",
    name: "Innovazione",
    body: "Studio e sperimento nuove tecnologie senza perdere di vista l'utilità concreta.",
  },
  {
    num: "05",
    name: "Crescita",
    body: "Crescere personalmente significa anche aiutare altre persone a crescere.",
  },
];

// Altre attività, successive al percorso IT principale.
// NOTA: verificare le diciture "Partner" / "Collaboratrice" prima della pubblicazione.
const aree = [
  {
    title: "Real Estate Internazionale",
    description:
      "Partner immobiliare iAD, con operatività sul mercato di Dubai. Accompagno chi cerca di investire e abitare in mercati internazionali in crescita.",
    meta: "001 / REAL ESTATE",
  },
  {
    title: "Innovazione e Tecnologie Emergenti",
    description:
      "Collaboratrice DBM ed esploratrice del mondo delle nuove tecnologie e delle criptovalute. Partner Sibill.",
    meta: "002 / INNOVAZIONE",
  },
  {
    title: "Network e Partnership Business",
    description:
      "Partner Jet HR, Fly Airlines. Collaboro con Castaldo Solutions per la consulenza societaria e fiscale.",
    meta: "003 / NETWORK",
  },
];

// Formazione. Anni non ancora verificati rimossi (year opzionale).
const formazione = [
  { name: "Davide Caiazzo", year: "2024" },
  { name: "Alfio Bardolla", year: "2024" },
  { name: "Giacomo Freddi", year: "" },
  { name: "Gasparotto", year: "2025" },
  { name: "Valerio Di Gerolamo", year: "2025" },
];

const testimonial = [
  "Ogni progetto nasce da un metodo: analisi, pianificazione, esecuzione, validazione e documentazione.",
  "La maturità professionale nasce quando le competenze diventano responsabilità verso le persone e i progetti.",
  "La tecnologia è importante, ma sono le persone a fare la differenza.",
];
---

<Base>
  <Nav />

  <main>
    <!-- ════════════════════════════════════════════════════════
         1 · HERO COVER
         ════════════════════════════════════════════════════════ -->
    <section class="hero-cinematic" aria-label="Copertina">
      <video
        class="hero-video"
        autoplay
        muted
        playsinline
        preload="auto"
        aria-hidden="true"
      >
        <source src="/hero-background.mp4" type="video/mp4" />
      </video>

      <div class="hero-overlay" aria-hidden="true"></div>

      <div class="hero-content">
        <span class="hero-eyebrow">Le stagioni di Patrizia · PGNetwork</span>
        <h1 class="hero-title">
          <span class="line-1">Tecnologia,</span>
          <span class="line-2">persone</span>
          <span class="line-3">e innovazione.</span>
        </h1>
        <p class="hero-tagline">
          Database &amp; Infrastructure. Il viaggio di una professionista tra
          competenza tecnica e valore reale per le persone.
        </p>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════
         2 · INTRO · CHI SONO (identità professionale)
         ════════════════════════════════════════════════════════ -->
    <section class="section intro-pro" id="chi-sono" aria-labelledby="intro-title">
      <div class="wrap intro-pro__grid">
        <div class="intro-pro__text">
          <p class="chapter__eyebrow reveal">CHI SONO</p>
          <h2 id="intro-title" class="intro-pro__title reveal">
            Mi chiamo Patrizia Gardis.
          </h2>
          <p class="prose reveal">
            Lavoro nel settore IT da oltre sette anni. Sono
            <strong class="strong">donna, madre, professionista e imprenditrice</strong>,
            ma il mio percorso principale nasce nella
            <em class="accent">Database Administration</em> e nelle
            infrastrutture IT.
          </p>
          <p class="prose reveal">
            Sono cresciuta attraverso progetti sempre più complessi:
            dall'operatività quotidiana alla progettazione di soluzioni
            infrastrutturali, al consolidamento di ambienti enterprise e alla
            collaborazione con team multidisciplinari. Metodo, responsabilità e
            attenzione ai dettagli sono il filo che tiene insieme ogni
            esperienza.
          </p>
        </div>
        <div class="intro-pro__media reveal">
          <img
            src="/patrizia-ritratto.jpg"
            alt="Ritratto di Patrizia Gardis"
            width="800"
            height="1200"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════
         3 · DATABASE & INFRASTRUCTURE · PGNETWORK
         ════════════════════════════════════════════════════════ -->
    <section class="section pg" id="pgnetwork" aria-labelledby="pg-title">
      <div class="wrap">
        <ChapterHero
          eyebrow="DATABASE & INFRASTRUCTURE · PGNETWORK"
          title="Il mio percorso, oggi un progetto."
          size="72"
        />
        <div class="pg__grid">
          <div class="pg__body">
            <p class="prose reveal">
              Da anni lavoro nel mondo della Database Administration e delle
              infrastrutture IT, collaborando su ambienti enterprise e progetti
              complessi.
            </p>
            <p class="prose reveal">
              Nel tempo il mio ruolo si è evoluto dall'operatività quotidiana alla
              progettazione, all'assessment, alla migrazione e al consolidamento
              di infrastrutture database.
            </p>
            <p class="prose reveal">
              Da questa evoluzione nasce <strong class="strong">PGNetwork</strong>,
              un progetto che sto costruendo per mettere in rete professionisti con
              competenze complementari e offrire alle aziende servizi Database
              &amp; Infrastructure strutturati, affidabili e continuativi.
            </p>
          </div>
          <div class="pg__poster">
            <PosterImage
              src="/poster-dietro-database.jpg"
              alt="Dietro un database non ci sono solo tabelle: il ruolo di un DBA"
              w={1024}
              h={1536}
              max="22rem"
              caption="Dietro un database non ci sono solo tabelle"
            />
          </div>
        </div>
        <div class="pg__tech">
          <p class="chapter__eyebrow reveal">TECNOLOGIE PRINCIPALI</p>
          <TechChips items={techMain} />
        </div>
      </div>
    </section>

    <!-- Manifesto PGNetwork (banda scura) -->
    <section class="manifesto-band" aria-label="Manifesto PGNetwork">
      <div class="wrap wrap--narrow">
        <blockquote class="manifesto-band__quote reveal">
          Non amministriamo soltanto database. Costruiamo infrastrutture
          affidabili, supportiamo le persone e trasformiamo la
          <em class="accent">complessità in valore</em>.
        </blockquote>
        <p class="manifesto-band__note reveal">
          PGNetwork è un progetto in crescita, non una grande società già
          strutturata: un modo di lavorare con metodo, sinergia e supporto
          continuo. Sono disponibile anche come
          <strong class="strong">partner DBA per società di consulenza IT</strong>,
          mettendo a disposizione professionisti specializzati per estendere i
          loro team quando serve.
        </p>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════
         4 · COMPETENZE TECNICHE
         ════════════════════════════════════════════════════════ -->
    <section class="section competenze" id="competenze" aria-labelledby="comp-title">
      <div class="wrap">
        <ChapterHero
          eyebrow="COMPETENZE"
          title="Database & Infrastructure, nel dettaglio"
          size="60"
        />
        <div class="competenze__grid">
          {competenze.map((c) => <SkillGroup {...c} />)}
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════
         5 · PROGETTO RECENTE
         ════════════════════════════════════════════════════════ -->
    <section class="section project" id="progetto" aria-labelledby="proj-title">
      <div class="wrap">
        <ChapterHero
          eyebrow="PROGETTO RECENTE"
          title="Enterprise Database Consolidation"
          size="60"
        />
        <div class="project__body">
          <p class="prose reveal">
            In circa due mesi ho partecipato al consolidamento e al riallineamento
            di molteplici ambienti database di un importante cliente enterprise,
            lavorando su tecnologie <em class="accent">Oracle, MongoDB e MySQL /
            MariaDB</em>.
          </p>
          <p class="prose reveal">
            Il progetto ha incluso assessment, pianificazione, refresh e
            migrazione degli ambienti, configurazioni di sicurezza, riallineamento
            delle dipendenze applicative, attività di backup e restore,
            troubleshooting, collaudo e documentazione tecnica.
          </p>
        </div>

        <ol class="flow reveal" aria-label="Fasi del progetto">
          {
            flusso.map((f, i) => (
              <li class="flow__step">
                <span class="flow__k">{f.k}</span>
                <span class="flow__d">{f.d}</span>
                {i < flusso.length - 1 && (
                  <span class="flow__arrow" aria-hidden="true">→</span>
                )}
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════
         6 · IL PUNTO DI SVOLTA (essay corretto)
         ════════════════════════════════════════════════════════ -->
    <section class="essay" aria-labelledby="cap1-title">
      <div class="essay__inner">
        <aside class="essay__aside">
          <div class="essay__sticky">
            <h2 id="cap1-title" class="essay__title reveal">
              Il punto di svolta
            </h2>
            <div class="essay__meta reveal">
              <span>IL PERCORSO</span>
              <span>PATRIZIA · IT</span>
            </div>
          </div>
        </aside>

        <div class="essay__body">
          <p class="prose reveal">
            Circa un anno fa la mia carriera ha attraversato uno dei cambiamenti
            più importanti del mio percorso. Quello che inizialmente sembrava un
            momento di incertezza si è trasformato in un'opportunità per evolvere
            professionalmente, ampliare le mie competenze e iniziare a costruire
            nuovi progetti.
          </p>
          <p class="prose reveal">
            Non sono diventata DBA dopo questo cambiamento: lavoravo già da anni
            nel settore. La vera evoluzione è stata passare progressivamente da
            attività di Service Desk e presidio cliente a un ruolo più orientato
            a progettazione e responsabilità.
          </p>

          <ul class="essay__list reveal" role="list">
            <li>Progettazione</li>
            <li>Assessment</li>
            <li>Migrazioni</li>
            <li>Consolidamento di infrastrutture database</li>
            <li>Gestione di ambienti enterprise</li>
            <li>Coordinamento di attività DBA applicative</li>
            <li>Formazione</li>
            <li>Collaborazione con team multidisciplinari</li>
            <li>Sviluppo di un mio network professionale</li>
          </ul>

          <blockquote class="pull reveal">
            Anche le prove più difficili possono trasformarsi in occasioni di
            crescita.
          </blockquote>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════
         7 · LE STAGIONI DI PATRIZIA
         ════════════════════════════════════════════════════════ -->
    <section class="seasons" id="stagioni" aria-labelledby="seasons-title">
      <div class="seasons__bg" aria-hidden="true"></div>
      <div class="seasons__content">
        <div class="wrap">
          <ChapterHero
            eyebrow="LE STAGIONI DI PATRIZIA"
            title="Il viaggio di una professionista tra tecnologia, persone e innovazione"
            size="60"
          />
        </div>

        <div class="wrap seasons__grid">
        {
          stagioni.map((s) => (
            <article class="season reveal">
              <span class="season__name">{s.season}</span>
              <h3 class="season__key">{s.key}</h3>
              <p class="season__body">{s.body}</p>
            </article>
          ))
        }
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════
         8 · VALORI (sezione chiara, sticky content-switch)
         ════════════════════════════════════════════════════════ -->
    <section class="manifesto" id="valori" aria-labelledby="valori-title">
      <div class="manifesto-inner">
        <aside class="manifesto-left">
          <div class="manifesto-left-sticky">
            <span class="manifesto-eyebrow">I valori di PGNetwork</span>
            <h2 id="valori-title" class="manifesto-title">Cinque valori.</h2>
            <div class="manifesto-counter" aria-hidden="true">
              <span class="manifesto-counter-num" data-counter>01</span>
              <span class="manifesto-counter-sep">·</span>
              <span class="manifesto-counter-label" data-label>Competenza</span>
            </div>
          </div>
        </aside>

        <div class="manifesto-right">
          {
            valori.map((p) => (
              <article
                class="manifesto-principle"
                data-principle={p.num}
                data-name={p.name}
              >
                <span class="manifesto-principle-num" aria-hidden="true">
                  {p.num}
                </span>
                <h3 class="manifesto-principle-name">{p.name}</h3>
                <p class="manifesto-principle-body">{p.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <script>
      (function () {
        const principles = document.querySelectorAll(".manifesto-principle");
        const counterNum = document.querySelector("[data-counter]");
        const counterLabel = document.querySelector("[data-label]");
        if (!principles.length || !counterNum || !counterLabel) return;

        let currentActive = "01";

        function updateCounter(num: string, name: string) {
          if (num === currentActive) return;
          currentActive = num;

          counterLabel.classList.add("is-changing");
          setTimeout(() => {
            counterNum.textContent = num;
            counterLabel.textContent = name;
            counterLabel.classList.remove("is-changing");
          }, 200);
        }

        const observer = new IntersectionObserver(
          (entries) => {
            let mostVisible: Element | null = null;
            let bestRatio = 0;

            entries.forEach((entry) => {
              if (entry.isIntersecting && entry.intersectionRatio > bestRatio) {
                bestRatio = entry.intersectionRatio;
                mostVisible = entry.target;
              }
            });

            if (mostVisible) {
              const el = mostVisible as HTMLElement;
              updateCounter(el.dataset.principle ?? "", el.dataset.name ?? "");
            }
          },
          {
            rootMargin: "-40% 0px -40% 0px",
            threshold: [0, 0.25, 0.5, 0.75, 1],
          },
        );

        principles.forEach((p) => observer.observe(p));
      })();
    </script>

    <!-- ════════════════════════════════════════════════════════
         9 · ALTRE ATTIVITÀ (dopo il percorso IT)
         ════════════════════════════════════════════════════════ -->
    <section class="section" id="altre-attivita" aria-labelledby="altre-title">
      <div class="wrap">
        <ChapterHero
          eyebrow="OLTRE LA TECNOLOGIA"
          title="Altre attività e collaborazioni"
          size="60"
        />
        <div class="altre__intro">
          <p class="prose prose--lead reveal">
            Attività complementari al mio percorso principale in ambito Database
            &amp; Infrastructure, nate dalla curiosità e da un network in
            crescita, tra cui l'esplorazione delle nuove tecnologie e delle
            criptovalute.
          </p>
          <PosterImage
            src="/poster-bitcoin-mining.jpg"
            alt="Prima di investire, scegli di capire: Bitcoin e Mining"
            w={1254}
            h={1254}
            max="24rem"
            caption="Innovazione · Bitcoin e Mining"
          />
        </div>
      </div>
      <div class="list">
        {
          aree.map((r, i) => (
            <VerticalRow
              {...r}
              variant={(["slide", "expand", "rule"] as const)[i]}
            />
          ))
        }
        <div class="list__close" aria-hidden="true"></div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════
         10 · LE RADICI (parte personale)
         ════════════════════════════════════════════════════════ -->
    <section class="section" id="radici" aria-labelledby="radici-title">
      <div class="wrap">
        <ChapterHero
          eyebrow="LE RADICI"
          title="Valori, famiglia e crescita"
          size="72"
        />

        <div class="life">
          <div class="life__main">
            <p class="prose reveal">
              Sono una professionista, una donna e una mamma di tre figli:
              Nicole, Loris e Nicolas. La <em class="accent">famiglia</em> è una
              delle mie più grandi motivazioni e mi ricorda ogni giorno perché
              vale la pena continuare a crescere, studiare e costruire.
            </p>
            <p class="prose reveal">
              Credo nel valore dell'educazione, dell'innovazione e dell'impatto
              positivo sulle persone, e voglio costruire qualcosa che abbia valore
              anche per le nuove generazioni.
            </p>
          </div>

          <div class="radici__media">
            <PosterImage
              src="/poster-competenza-persone.jpg"
              alt="Quando competenza, passione e persone si incontrano, nascono grandi progetti"
              w={1254}
              h={1254}
              max="26rem"
              caption="Radici forti · Ali per crescere"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════
         11 · LA MISSIONE (Santo Domingo)
         ════════════════════════════════════════════════════════ -->
    <section class="mission" aria-labelledby="mission-title">
      <div class="wrap wrap--narrow">
        <p class="chapter__eyebrow chapter__eyebrow--center reveal">
          LA MISSIONE
        </p>
        <h2 id="mission-title" class="mission__title reveal">Restituire</h2>

        <div class="mission__prose">
          <p class="prose prose--center reveal">
            Uno dei sogni che porto avanti è contribuire, un giorno, alla
            realizzazione di una <em class="accent">scuola a Santo Domingo</em>,
            il mio Paese d'origine, per offrire ai giovani maggiori possibilità di
            formazione e futuro.
          </p>
          <p class="prose prose--center reveal">
            Sostengo personalmente cause legate all'infanzia e all'educazione,
            perché credo che ogni opportunità data a un bambino sia un
            investimento sul mondo che lasceremo.
          </p>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════
         12 · VITA PRIVATA
         ════════════════════════════════════════════════════════ -->
    <section class="section" aria-labelledby="vita-title">
      <div class="wrap">
        <ChapterHero
          eyebrow="VITA PRIVATA"
          title="Quello che mi tiene viva"
          size="72"
        />

        <div class="life">
          <div class="life__main">
            <p class="prose reveal">
              Fuori dal lavoro coltivo passioni che mi danno energia: la
              <em class="accent">danza</em>, in tutte le sue forme, perché è
              libertà ed espressione. Il <em class="accent">canto</em>, non a
              livello professionale ma come modo per ritrovare equilibrio. I
              <em class="accent">viaggi</em>, perché ogni cultura nuova allarga lo
              sguardo. La <em class="accent">fotografia</em>, perché mi permette di
              trattenere quello che altrimenti scivolerebbe via.
            </p>
            <p class="prose reveal">
              Di recente ho intrapreso anche un percorso nel mondo della moda come
              modella presso Identity Agency di Milano: un'esperienza che mi sta
              insegnando presenza, sicurezza e una nuova consapevolezza di me.
            </p>
          </div>

          <aside class="life__aside" aria-hidden="true">
            <div class="life__sep"></div>
            <span class="life__vmeta">PATRIZIA · 2026 · ITALIA</span>
          </aside>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════
         13 · FORMAZIONE
         ════════════════════════════════════════════════════════ -->
    <section class="section" id="formazione" aria-labelledby="form-title">
      <div class="wrap">
        <ChapterHero
          eyebrow="FORMAZIONE"
          title="I percorsi che hanno costruito la mia visione"
          size="60"
        />
        <p class="prose prose--lead reveal">
          Ho investito tempo, energie e risorse nella mia formazione personale e
          professionale: marketing, leadership, crescita personale, investimenti,
          gestione imprenditoriale.
