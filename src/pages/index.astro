---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import ChapterHero from "../components/ChapterHero.astro";
import VerticalRow from "../components/VerticalRow.astro";

// ── Data (draft copy, modificabile) ───────────────────────────

const aree = [
  {
    title: "Real Estate Internazionale",
    description:
      "Partner immobiliare iAD, con operatività sul mercato di Dubai. Accompagno chi cerca di investire e abitare in mercati internazionali in crescita.",
    meta: "001 / TRE PROGETTI",
  },
  {
    title: "Innovazione e Tecnologie Emergenti",
    description:
      "Collaboratrice DBM ed esploratrice del mondo delle nuove tecnologie e delle criptovalute. Partner Sibill. Collaboratrice ScripDBA.com.",
    meta: "002 / TRE PROGETTI",
  },
  {
    title: "Network e Partnership Business",
    description:
      "Partner Jet HR, Ambrogio, Fly Airlines. Collaboro con Castaldo Solutions per la consulenza societaria e fiscale.",
    meta: "003 / QUATTRO PROGETTI",
  },
];

const principi = [
  {
    num: "01",
    name: "Innovazione",
    body: "La tecnologia è strumento, non fine. Serve a creare valore reale per le persone, non a impressionare.",
  },
  {
    num: "02",
    name: "Maternità",
    body: "Tre figli, tre ragioni per costruire un mondo migliore. Ogni decisione che prendo è anche per loro.",
  },
  {
    num: "03",
    name: "Impatto",
    body: "Il successo che non genera valore per gli altri non è successo. È solo accumulo.",
  },
];

const formazione = [
  { name: "Davide Caiazzo", year: "2024" },
  { name: "Alfio Bardolla", year: "2024" },
  { name: "Giacomo Freddi", year: "2024" },
  { name: "Gasparotto", year: "2025" },
  { name: "Valerio Di Gerolamo", year: "2025" },
];

const testimonial = [
  "Anche le prove più difficili possono trasformarsi in occasioni di crescita.",
  "Il successo non è solo un traguardo professionale, è la capacità di evolvere.",
  "Voglio unire innovazione, business e impatto sociale per creare valore concreto.",
];
---

<Base>
  <Nav />

  <main>
    <!-- ════════════════════════════════════════════════════════
         1 · HERO COVER
         ════════════════════════════════════════════════════════ -->
    <section class="hero-cinematic" aria-label="Copertina">
      <!-- Layer 1: video di sfondo (decorativo, muto, una sola riproduzione) -->
      <video
        class="hero-video"
        autoplay
        muted
        playsinline
        preload="auto"
        aria-hidden="true"
      >
        <source src="/hero-background.mp4" type="video/mp4" />
      </video>

      <!-- Layer 2: overlay scuro per leggibilità -->
      <div class="hero-overlay" aria-hidden="true"></div>

      <!-- Layer 3: contenuto hero (eyebrow + titolo) -->
      <div class="hero-content">
        <span class="hero-eyebrow">Capitolo Zero — Una rinascita</span>
        <h1 class="hero-title">
          <span class="line-1">Vivere</span>
          <span class="line-2">due volte</span>
          <span class="line-3">con intenzione.</span>
        </h1>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════
         2 · INTRO PARAGRAPH
         ════════════════════════════════════════════════════════ -->
    <section class="intro" aria-label="Introduzione">
      <p class="intro__text reveal">
        Mi chiamo Patrizia. Sono madre, professionista, donna. Due anni fa ho
        avuto un <em class="accent">ictus</em>. Da quel giorno ho smesso di
        vivere come se avessi tempo da perdere e ho iniziato a costruire
        <strong class="strong">qualcosa che valga la pena lasciare</strong>.
      </p>
    </section>

    <!-- ════════════════════════════════════════════════════════
         3 · CAPITOLO 1 — IL PUNTO DI SVOLTA (two-column essay)
         ════════════════════════════════════════════════════════ -->
    <section class="essay" aria-labelledby="cap1-title">
      <div class="essay__inner">
        <aside class="essay__aside">
          <div class="essay__sticky">
            <h2 id="cap1-title" class="essay__title reveal">
              Il punto di svolta
            </h2>
            <div class="essay__meta reveal">
              <span>CAPITOLO UNO</span>
              <span>PATRIZIA · 2024</span>
            </div>
          </div>
        </aside>

        <div class="essay__body">
          <p class="prose reveal">
            Non è stato un percorso facile. Ha richiesto forza, coraggio,
            pazienza e la capacità di rimettermi in gioco. Ma proprio da quella
            esperienza è nata una nuova consapevolezza.
          </p>
          <p class="prose reveal">
            Quel momento mi ha insegnato a dare valore al tempo, alla salute,
            alla famiglia, alle opportunità che la vita offre ogni giorno. Mi ha
            spinta a guardare oltre i miei limiti, a credere nelle mie capacità,
            a investire con determinazione nella mia crescita personale e
            professionale.
          </p>

          <blockquote class="pull reveal">
            Anche le prove più difficili possono trasformarsi in occasioni di
            rinascita.
          </blockquote>

          <p class="prose reveal">
            Un anno fa ho preso una delle decisioni più importanti della mia
            vita: lasciare il lavoro da dipendente per intraprendere un percorso
            completamente nuovo.
          </p>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════
         4 · CAPITOLO 2 — LE AREE IN CUI LAVORO (vertical list)
         ════════════════════════════════════════════════════════ -->
    <section class="section" aria-labelledby="cap2-title">
      <div class="wrap">
        <ChapterHero
          eyebrow="CAPITOLO DUE — IL PRESENTE"
          title="Cosa costruisco oggi"
          size="72"
        />
      </div>
      <div class="list">
        {aree.map((r) => <VerticalRow {...r} />)}
        <div class="list__close" aria-hidden="true"></div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════
         5 · CAPITOLO 3 — MANIFESTO (light, inverted)
         ════════════════════════════════════════════════════════ -->
    <section class="manifesto" id="capitolo-tre" aria-labelledby="cap3-title">
      <div class="manifesto-inner">
        <!-- Colonna sinistra (sticky) -->
        <aside class="manifesto-left">
          <div class="manifesto-left-sticky">
            <span class="manifesto-eyebrow">Capitolo Tre — Il Manifesto</span>
            <h2 id="cap3-title" class="manifesto-title">Tre principi.</h2>
            <div class="manifesto-counter" aria-hidden="true">
              <span class="manifesto-counter-num" data-counter>01</span>
              <span class="manifesto-counter-sep">—</span>
              <span class="manifesto-counter-label" data-label>Innovazione</span>
            </div>
          </div>
        </aside>

        <!-- Colonna destra (scrollabile) -->
        <div class="manifesto-right">
          {
            principi.map((p) => (
              <article
                class="manifesto-principle"
                data-principle={p.num}
                data-name={p.name}
              >
                <span class="manifesto-principle-num" aria-hidden="true">
                  {p.num}
                </span>
                <h3 class="manifesto-principle-name">{p.name}</h3>
                <p class="manifesto-principle-body">{p.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Content-switch del counter sticky (Capitolo 3) -->
    <script>
      (function () {
        const principles = document.querySelectorAll(".manifesto-principle");
        const counterNum = document.querySelector("[data-counter]");
        const counterLabel = document.querySelector("[data-label]");
        if (!principles.length || !counterNum || !counterLabel) return;

        let currentActive = "01";

        function updateCounter(num: string, name: string) {
          if (num === currentActive) return;
          currentActive = num;

          counterLabel.classList.add("is-changing");
          setTimeout(() => {
            counterNum.textContent = num;
            counterLabel.textContent = name;
            counterLabel.classList.remove("is-changing");
          }, 200);
        }

        const observer = new IntersectionObserver(
          (entries) => {
            let mostVisible: Element | null = null;
            let bestRatio = 0;

            entries.forEach((entry) => {
              if (entry.isIntersecting && entry.intersectionRatio > bestRatio) {
                bestRatio = entry.intersectionRatio;
                mostVisible = entry.target;
              }
            });

            if (mostVisible) {
              const el = mostVisible as HTMLElement;
              updateCounter(
                el.dataset.principle ?? "",
                el.dataset.name ?? "",
              );
            }
          },
          {
            // attivo solo nella fascia centrale del viewport (40% sopra/sotto morti)
            rootMargin: "-40% 0px -40% 0px",
            threshold: [0, 0.25, 0.5, 0.75, 1],
          },
        );

        principles.forEach((p) => observer.observe(p));
      })();
    </script>

    <!-- ════════════════════════════════════════════════════════
         6 · CAPITOLO 4 — LA MISSIONE (full-width centered)
         ════════════════════════════════════════════════════════ -->
    <section class="mission" aria-labelledby="cap4-title">
      <div class="wrap wrap--narrow">
        <p class="chapter__eyebrow chapter__eyebrow--center reveal">
          CAPITOLO QUATTRO — LA MISSIONE
        </p>
        <h2 id="cap4-title" class="mission__title reveal">Tornare a casa</h2>

        <div class="mission__prose">
          <p class="prose prose--center reveal">
            Sono nata a Santo Domingo. È il Paese da cui sono partita, ed è il
            Paese a cui penso quando immagino dove andrà a finire tutto quello
            che sto costruendo.
          </p>
          <p class="prose prose--center reveal">
            Uno dei sogni che porto avanti è contribuire alla realizzazione di
            una <em class="accent">scuola a Santo Domingo</em>, per offrire ai
            giovani del mio Paese d'origine maggiori possibilità di formazione e
            futuro.
          </p>
          <p class="prose prose--center reveal">
            Sostengo personalmente cause legate all'infanzia e all'educazione,
            perché credo che ogni opportunità data a un bambino sia un
            investimento sul mondo che lasceremo.
          </p>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════
         7 · CAPITOLO 5 — FAMIGLIA E PASSIONI (asymmetric essay)
         ════════════════════════════════════════════════════════ -->
    <section class="section" aria-labelledby="cap5-title">
      <div class="wrap">
        <ChapterHero
          eyebrow="CAPITOLO CINQUE — VITA PRIVATA"
          title="Quello che mi tiene viva"
          size="72"
        />

        <div class="life">
          <div class="life__main">
            <p class="prose reveal">
              Sono mamma di tre figli: Nicole, Loris e Nicolas. La maternità è
              la più grande motivazione che ho.
            </p>
            <p class="prose reveal">
              Fuori dal lavoro coltivo passioni che mi danno energia: la
              <em class="accent">danza</em>, in tutte le sue forme, perché è
              libertà ed espressione. Il <em class="accent">canto</em>, non a
              livello professionale ma come modo per ritrovare equilibrio. I
              <em class="accent">viaggi</em>, perché ogni cultura nuova allarga
              lo sguardo. La <em class="accent">fotografia</em>, perché mi
              permette di trattenere quello che altrimenti scivolerebbe via.
            </p>
            <p class="prose reveal">
              Di recente ho intrapreso un percorso nel mondo della moda come
              modella presso Identity Agency di Milano. Un'esperienza che mi sta
              insegnando presenza, sicurezza e una nuova consapevolezza del
              corpo dopo l'ictus.
            </p>
          </div>

          <aside class="life__aside" aria-hidden="true">
            <div class="life__sep"></div>
            <span class="life__vmeta">PATRIZIA · 2026 · ITALIA</span>
          </aside>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════
         8 · CAPITOLO 6 — IL PERCORSO FORMATIVO (vertical list)
         ════════════════════════════════════════════════════════ -->
    <section class="section" aria-labelledby="cap6-title">
      <div class="wrap">
        <ChapterHero
          eyebrow="CAPITOLO SEI — FORMAZIONE"
          title="I percorsi che hanno costruito la mia visione"
          size="60"
        />
        <p class="prose prose--lead reveal">
          Ho investito tempo, energie e risorse nella mia formazione personale e
          professionale. Marketing, leadership, crescita personale, investimenti,
          gestione imprenditoriale.
        </p>
      </div>

      <div class="formative">
        {
          formazione.map((f) => (
            <div class="formative__row reveal">
              <span class="formative__name">{f.name}</span>
              <span class="formative__year">{f.year}</span>
            </div>
          ))
        }
      </div>

      <div class="wrap">
        <p class="formative__note reveal">
          I PERCORSI ELENCATI SONO STATI SEGUITI A TITOLO FORMATIVO E NON
          RAPPRESENTANO COLLABORAZIONI ATTIVE NÉ ENDORSEMENT RECIPROCI.
        </p>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════
         9 · TESTIMONIAL EDITORIALI (centered quotes)
         ════════════════════════════════════════════════════════ -->
    <section class="quotes" aria-label="In poche parole">
      <p class="chapter__eyebrow chapter__eyebrow--center reveal">
        CAPITOLO SETTE — IN POCHE PAROLE
      </p>
      <div class="quotes__list">
        {
          testimonial.map((q) => (
            <figure class="quote reveal">
              <blockquote class="quote__text">{q}</blockquote>
              <figcaption class="quote__cite">— PATRIZIA</figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════
         10 · CALL TO ACTION CARD
         ════════════════════════════════════════════════════════ -->
    <section class="cta" aria-labelledby="cta-title">
      <div class="cta__card reveal">
        <div class="cta__head">
          <span>VERSIONE / I</span>
          <span>EDIZIONE / 2026</span>
        </div>

        <h2 id="cta-title" class="cta__title">Entriamo in contatto.</h2>
        <p class="cta__lead">
          Se quello che hai letto risuona con un progetto che stai costruendo,
          scrivimi. Risponderò personalmente.
        </p>

        <form class="form" novalidate>
          <div class="field">
            <label class="field__label" for="nome">Nome</label>
            <input
              class="field__input"
              type="text"
              id="nome"
              name="nome"
              autocomplete="name"
              placeholder="Il tuo nome"
            />
          </div>
          <div class="field">
            <label class="field__label" for="email">Email</label>
            <input
              class="field__input"
              type="email"
              id="email"
              name="email"
              autocomplete="email"
              placeholder="La tua email"
            />
          </div>
          <div class="field">
            <label class="field__label" for="messaggio">Messaggio</label>
            <textarea
              class="field__input field__textarea"
              id="messaggio"
              name="messaggio"
              rows="4"
              placeholder="Raccontami in breve"></textarea>
          </div>

          <button class="form__submit" type="submit">INVIA</button>
        </form>

        <p class="cta__disclaimer">
          I tuoi dati saranno trattati nel rispetto del GDPR.
          <a href="#">Privacy policy</a>.
        </p>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════
         11 · FINAL STATEMENT (full screen)
         ════════════════════════════════════════════════════════ -->
    <section class="final" aria-label="Statement finale">
      <h2 class="final__headline reveal">
        <span class="final__line">Costruire</span>
        <span class="final__line final__line--italic">con</span>
        <span class="final__line">intenzione.</span>
      </h2>
    </section>
  </main>

  <!-- ════════════════════════════════════════════════════════
       12 · FOOTER
       ════════════════════════════════════════════════════════ -->
  <footer class="footer">
    <div class="footer__inner">
      <p class="footer__copy">
        PATRIZIA · © MMXXVI · TUTTI I DIRITTI RISERVATI
      </p>
      <nav class="footer__links" aria-label="Link di servizio">
        <a href="#">LINKEDIN</a>
        <a href="#">EMAIL</a>
        <a href="#">PRIVACY</a>
        <a href="#">NOTE LEGALI</a>
      </nav>
    </div>
  </footer>
</Base>

<style>
  /* ── Shared wrappers ──────────────────────────────────────── */
  .wrap {
    max-width: 80rem;
    margin: 0 auto;
    padding-inline: clamp(1.25rem, 5vw, 4rem);
  }
  .wrap--narrow {
    max-width: 56rem;
  }
  .section {
    padding-block: clamp(6rem, 14vw, 11rem);
  }

  /* ── Prose ────────────────────────────────────────────────── */
  .prose {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: clamp(1.125rem, 1.6vw, 1.375rem);
    line-height: 1.7;
    color: var(--paper);
    margin: 0 0 1.6em;
    max-width: 65ch;
  }
  .prose--center {
    margin-inline: auto;
    text-align: center;
  }
  .prose--lead {
    margin-top: 2.5rem;
    font-size: clamp(1.25rem, 1.9vw, 1.5rem);
    color: var(--muted);
  }
  .accent {
    color: var(--accent);
    font-style: italic;
  }
  .strong {
    font-weight: 600;
    color: var(--paper);
  }

  /* ════ 1 · HERO CINEMATIC (video background) ══════════════ */
  .hero-cinematic {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background: #0a0a0c; /* fallback se il video non carica */
  }

  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 1;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(10, 10, 12, 0.5) 0%,
      rgba(10, 10, 12, 0.35) 40%,
      rgba(10, 10, 12, 0.7) 100%
    );
    z-index: 2;
  }

  .hero-content {
    position: relative;
    z-index: 3;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 0 8vw;
  }

  .hero-eyebrow {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 4vh;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-optical-sizing: auto;
    font-weight: 300;
    line-height: 0.9;
    letter-spacing: -0.025em;
    color: var(--paper);
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .hero-title .line-1 {
    font-style: italic;
    font-size: 13vw;
  }
  .hero-title .line-2 {
    font-weight: 300;
    color: var(--accent);
    font-size: 13vw;
  }
  .hero-title .line-3 {
    font-weight: 400;
    font-size: 13vw;
    align-self: flex-end;
    text-align: right;
  }

  /* ════ 2 · INTRO ══════════════════════════════════════════ */
  .intro {
    max-width: 56rem;
    margin: 0 auto;
    padding: clamp(7rem, 14vw, 9rem) clamp(1.25rem, 5vw, 4rem);
  }
  .intro__text {
    margin: 0;
    font-family: var(--font-serif);
    font-optical-sizing: auto;
    font-weight: 300;
    font-size: clamp(1.75rem, 3.6vw, 3rem);
    line-height: 1.3;
    color: var(--paper);
    text-wrap: balance;
  }
  .intro__text .accent {
    font-style: italic;
  }
  .intro__text .strong {
    font-weight: 600;
  }

  /* ════ 3 · ESSAY (two-column) ═════════════════════════════ */
  .essay {
    padding-block: clamp(5rem, 11vw, 9rem);
  }
  .essay__inner {
    max-width: 80rem;
    margin: 0 auto;
    padding-inline: clamp(1.25rem, 5vw, 4rem);
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: clamp(2rem, 6vw, 5rem);
  }
  .essay__sticky {
    position: sticky;
    top: 8rem;
  }
  .essay__title {
    margin: 0 0 1.5rem;
    font-family: var(--font-serif);
    font-optical-sizing: auto;
    font-weight: 300;
    font-size: clamp(2.5rem, 5vw, 3.75rem);
    line-height: 1.05;
    color: var(--paper);
  }
  .essay__meta {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    color: var(--muted);
  }
  .essay__body {
    max-width: 38rem;
  }
  .pull {
    margin: 2.5rem 0;
    padding-left: 2rem;
    border-left: 4px solid var(--accent);
    font-family: var(--font-serif);
    font-optical-sizing: auto;
    font-style: italic;
    font-weight: 300;
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    line-height: 1.25;
    color: var(--paper);
  }

  /* ════ 4 · VERTICAL LIST ══════════════════════════════════ */
  .list {
    max-width: 80rem;
    margin: clamp(3rem, 6vw, 5rem) auto 0;
    padding-inline: clamp(1.25rem, 5vw, 4rem);
  }
  .list__close {
    border-top: 1px solid var(--rule);
  }

  /* ════ 5 · MANIFESTO (inverted, sticky content-switch) ════ */
  .manifesto {
    background: var(--paper);
    color: var(--canvas);
    /* niente padding verticale: la sezione parte dal primo principio e
       finisce sull'ultimo, simmetrica in cima e in fondo */
    padding: 0;
  }
  .manifesto-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 8vw;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8vw;
    /* stretch: la colonna sinistra prende l'altezza della destra, così la
       sticky resta pinnata per tutti e 3 i principi e si rilascia solo alla fine */
    align-items: stretch;
  }

  /* Colonna sinistra sticky */
  .manifesto-left {
    position: relative;
    min-height: 100vh;
  }
  .manifesto-left-sticky {
    position: sticky;
    /* centrato verticalmente: il titolo resta allineato ai principi
       (anch'essi centrati) e a fine sezione non lascia vuoto sotto */
    top: 50%;
    transform: translateY(-50%);
  }
  .manifesto-eyebrow {
    display: block;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(10, 10, 12, 0.5);
