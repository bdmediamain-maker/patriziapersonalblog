---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import ChapterHero from "../components/ChapterHero.astro";
import SkillGroup from "../components/SkillGroup.astro";
import PosterImage from "../components/PosterImage.astro";

// ── Dati ──────────────────────────────────────────────────────

const stack = [
  "Oracle",
  "SQL Server",
  "PostgreSQL",
  "MongoDB",
  "Db2",
  "MySQL",
  "Linux",
];

const servizi = [
  "Database Administration",
  "Migration",
  "Consolidation",
  "Security",
  "Backup & Recovery",
  "Infrastructure Assessment",
];

const competenze = [
  {
    num: "01",
    title: "Database Administration",
    items: [
      "Oracle 12c / 18c / 19c",
      "Microsoft SQL Server",
      "PostgreSQL",
      "MongoDB",
      "IBM Db2",
      "MySQL / MariaDB",
    ],
  },
  {
    num: "02",
    title: "Oracle & Enterprise",
    items: [
      "RMAN / RMAN Duplicate",
      "Data Pump (expdp / impdp)",
      "Security, CMU, Wallet",
      "AD / LDAP / Kerberos",
      "Unified Auditing, WebLogic",
      "Oracle Net / TNS, Listener",
    ],
  },
  {
    num: "03",
    title: "Migration & Consolidation",
    items: [
      "Database Migration",
      "Production Refresh",
      "Database Consolidation",
      "Backup & Restore",
      "Assessment infrastrutturali",
      "Validazione post-migrazione",
    ],
  },
  {
    num: "04",
    title: "Infrastructure",
    items: [
      "Linux / Red Hat / CentOS",
      "IBM AIX",
      "Bash / Shell scripting",
      "Networking / DNS",
      "Monitoring",
      "Runbook / Confluence",
    ],
  },
];

const flusso = [
  { k: "Assessment", d: "Analisi ambiente e criticità" },
  { k: "Planning", d: "Strategia e piano operativo" },
  { k: "Migration", d: "Migrazione e riallineamento" },
  { k: "Validation", d: "Collaudo e verifica" },
  { k: "Documentation", d: "Runbook e knowledge base" },
  { k: "Support", d: "Continuità e handover" },
];

const valori = [
  { name: "Competenza", body: "Formazione continua e specializzazione tecnica." },
  { name: "Affidabilità", body: "Responsabilità e continuità in ogni fase." },
  { name: "Collaborazione", body: "Squadra e condivisione tra professionisti." },
  { name: "Innovazione", body: "Nuove tecnologie con utilità concreta." },
  { name: "Crescita", body: "Crescere e far crescere gli altri." },
];

const stagioni = [
  { season: "Inverno", key: "Cambiamento", body: "Ridefinire la direzione." },
  { season: "Primavera", key: "Crescita", body: "Studio, formazione, nuovi progetti." },
  { season: "Estate", key: "Costruzione", body: "Progetti enterprise e nascita di PGNetwork." },
  { season: "Autunno", key: "Condivisione", body: "Restituire competenze e opportunità." },
];

// Oltre la tecnologia · attività complementari al percorso IT.
const interessi = [
  {
    title: "Real Estate Internazionale",
    meta: "Dubai · iAD",
    desc: "Partner immobiliare iAD sul mercato di Dubai.",
  },
  {
    title: "Innovazione & Cripto",
    meta: "DBM · Sibill",
    desc: "Collaboratrice DBM ed esploratrice di nuove tecnologie e criptovalute. Partner Sibill.",
    href: "https://sibill.com/referral-program/?referral_code=PATGARWYMD",
    cta: "Scopri Sibill",
  },
  {
    title: "Network & Partnership",
    meta: "Jet HR · Fly Airlines",
    desc: "Partner Jet HR e Fly Airlines, nel mio network di collaborazioni professionali.",
  },
  {
    title: "Trading & Mercati",
    meta: "Financial Education",
    desc: "Percorso di studio su analisi tecnica, metodo e gestione del rischio.",
  },
];

// Formazione sintetica · quattro categorie.
// NOTA: associazione dei riferimenti alle categorie da confermare col cliente.
const formazione = [
  {
    cat: "Technology & AI",
    desc: "Database, infrastrutture, cloud e AI applicata.",
    refs: ["Aggiornamento tecnico continuo"],
  },
  {
    cat: "Business",
    desc: "Gestione d'impresa, leadership e strategia.",
    refs: ["Davide Caiazzo", "Giacomo Freddi"],
  },
  {
    cat: "Marketing & Personal Branding",
    desc: "Comunicazione, brand personale e posizionamento.",
    refs: ["Valerio Di Gerolamo", "Gasparotto"],
  },
  {
    cat: "Financial Education",
    desc: "Investimenti, mercati e gestione del rischio.",
    refs: [
      "Alfio Bardolla",
      "Lux Trading Academy",
      "Giordi Locatelli",
      "Andrea Giudice · CGA University",
    ],
  },
];

const journal = [
  {
    src: "/poster-dietro-database.jpg",
    alt: "Dietro un database non ci sono solo tabelle: il ruolo di un DBA",
    w: 1024,
    h: 1536,
    caption: "Il ruolo di un DBA",
  },
  {
    src: "/poster-rto-rpo.jpg",
    alt: "RTO e RPO: le due metriche chiave del Disaster Recovery",
    w: 1254,
    h: 1254,
    caption: "RTO & RPO nel Disaster Recovery",
  },
  {
    src: "/poster-summer-offer.jpg",
    alt: "Assessment di database e infrastrutture",
    w: 1254,
    h: 1254,
    caption: "Database & Infrastructure Assessment",
  },
  {
    src: "/poster-bitcoin-mining.jpg",
    alt: "Prima di investire, scegli di capire: Bitcoin e Mining",
    w: 1254,
    h: 1254,
    caption: "Bitcoin & Mining",
  },
];
---

<Base>
  <Nav />

  <main>
    <!-- ════════════════════════════════════════════════════════
         1 · HOME · HERO
         ════════════════════════════════════════════════════════ -->
    <section class="hero-cinematic" aria-label="Copertina">
      <video
        class="hero-video"
        autoplay
        muted
        playsinline
        preload="auto"
        aria-hidden="true"
      >
        <source src="/hero-background.mp4" type="video/mp4" />
      </video>

      <div class="hero-overlay" aria-hidden="true"></div>

      <div class="hero-content">
        <span class="hero-eyebrow">PATRIZIA GARDIS · PGNETWORK</span>
        <h1 class="hero-title">
          <span class="line-1">Database &amp;</span>
          <span class="line-2">Infrastructure</span>
          <span class="line-3">Consultant.</span>
        </h1>
        <p class="hero-role">Founder di PGNetwork</p>
        <p class="hero-tagline">
          Oltre sette anni nell'IT enterprise. Progetto, metto in sicurezza e
          consolido database e infrastrutture critiche.
        </p>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════
         2 · HOME · POSIZIONAMENTO (keyword + CTA)
         ════════════════════════════════════════════════════════ -->
    <section class="section strip" aria-label="Specializzazione">
      <div class="wrap">
        <div class="strip__row reveal">
          <span class="strip__label">Stack</span>
          <ul class="keywords" role="list">
            {stack.map((k) => <li>{k}</li>)}
          </ul>
        </div>
        <div class="strip__row reveal">
          <span class="strip__label">Servizi</span>
          <ul class="keywords" role="list">
            {servizi.map((k) => <li>{k}</li>)}
          </ul>
        </div>
        <div class="strip__cta reveal">
          <p class="strip__statement">
            Una specializzazione chiara, un metodo verificabile.
          </p>
          <a class="btn" href="#contatti">Entriamo in contatto</a>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════
         3 · EXPERTISE
         ════════════════════════════════════════════════════════ -->
    <section class="section" id="expertise" aria-labelledby="exp-title">
      <div class="wrap">
        <ChapterHero
          eyebrow="EXPERTISE"
          title="Database & Infrastructure"
          size="72"
        />
        <p class="prose prose--lead reveal">
          Lavoro nel settore IT da oltre sette anni, con una specializzazione
          precisa: Database Administration e infrastrutture enterprise.
        </p>
        <p class="prose reveal">
          Nel tempo il mio ruolo si è evoluto dall'operatività quotidiana alla
          progettazione di soluzioni infrastrutturali, all'assessment, alla
          migrazione e al consolidamento di ambienti database complessi.
          Metodo, responsabilità e attenzione ai dettagli sono il filo che
          tiene insieme ogni progetto, dall'analisi iniziale fino alla
          documentazione e all'handover.
        </p>
        <div class="competenze__grid">
          {competenze.map((c) => <SkillGroup {...c} />)}
        </div>
      </div>

      <!-- Proof · progetto recente ridotto a numeri/keyword -->
      <div class="wrap proof">
        <div class="proof__head reveal">
          <span class="chapter__eyebrow">PROGETTO RECENTE</span>
          <h3 class="proof__title">Enterprise Database Consolidation</h3>
        </div>
        <ul class="proof__stats reveal" role="list">
          <li><span class="proof__num">~2</span><span class="proof__lab">mesi</span></li>
          <li><span class="proof__num">3</span><span class="proof__lab">tecnologie core</span></li>
          <li><span class="proof__num">Multi</span><span class="proof__lab">ambienti enterprise</span></li>
          <li><span class="proof__num">6</span><span class="proof__lab">fasi di metodo</span></li>
        </ul>
        <p class="prose reveal">
          In circa due mesi ho partecipato al consolidamento e al riallineamento
          di molteplici ambienti database di un importante cliente enterprise,
          lavorando su tecnologie <em class="accent">Oracle, MongoDB e MySQL /
          MariaDB</em>.
        </p>
        <p class="prose reveal">
          Il progetto ha incluso assessment, pianificazione, refresh e
          migrazione degli ambienti, configurazioni di sicurezza, riallineamento
          delle dipendenze applicative, backup e restore, troubleshooting,
          collaudo e documentazione tecnica.
        </p>
        <ol class="flow reveal" aria-label="Fasi del progetto">
          {
            flusso.map((f, i) => (
              <li class="flow__step">
                <span class="flow__k">{f.k}</span>
                <span class="flow__d">{f.d}</span>
                {i < flusso.length - 1 && (
                  <span class="flow__arrow" aria-hidden="true">→</span>
                )}
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════
         4 · PGNETWORK
         ════════════════════════════════════════════════════════ -->
    <section class="section pg" id="pgnetwork" aria-labelledby="pg-title">
      <div class="wrap">
        <ChapterHero
          eyebrow="PGNETWORK"
          title="L'evoluzione: un network."
          size="72"
        />
        <div class="pg__grid">
          <div class="pg__body">
            <p class="prose reveal">
              Da anni lavoro nella Database Administration e nelle infrastrutture
              IT, collaborando su ambienti enterprise e progetti complessi. Nel
              tempo il mio ruolo si è evoluto dall'operatività alla
              progettazione, all'assessment, alla migrazione e al consolidamento.
            </p>
            <p class="prose reveal">
              Da questa evoluzione nasce <strong class="strong">PGNetwork</strong>:
              un network di professionisti IT specializzati che lavorano in
              sinergia per offrire ad aziende e partner servizi Database &amp;
              Infrastructure strutturati, affidabili e continuativi.
            </p>
            <p class="prose reveal">
              È un progetto in crescita, non una grande società già strutturata:
              un modo di lavorare con metodo, sinergia e supporto continuo. Sono
              disponibile anche come <em class="accent">partner DBA per società
              di consulenza IT</em>, per estendere i loro team quando serve.
            </p>
          </div>
          <div class="pg__poster">
            <PosterImage
              src="/poster-opportunita.jpg"
              alt="Ogni stagione porta nuove opportunità"
              w={1024}
              h={1536}
              max="20rem"
              caption="Un progetto in crescita"
            />
          </div>
        </div>

        <ul class="values reveal" role="list">
          {
            valori.map((v) => (
              <li class="value">
                <span class="value__name">{v.name}</span>
                <span class="value__body">{v.body}</span>
              </li>
            ))
          }
        </ul>

        <div class="pg-partner reveal">
          <span class="chapter__eyebrow">PARTNER TECNOLOGICO</span>
          <p class="prose">
            In sinergia con <strong class="strong">Castaldo Solutions</strong>,
            partner tecnologico e system integrator in ambito
            <em class="accent">AI full stack</em>. Loro l'intelligenza
            artificiale, PGNetwork i database e le infrastrutture: Oracle,
            PostgreSQL e altro.
          </p>
          <a
            class="pg-partner__link"
            href="https://www.castaldosolutions.it/"
            target="_blank"
            rel="noopener noreferrer"
          >
            castaldosolutions.it <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <div class="pg-quote">
        <div class="wrap wrap--narrow">
          <blockquote class="pg-quote__text reveal">
            Non amministriamo soltanto database. Trasformiamo la
            <em class="accent">complessità in valore</em>.
          </blockquote>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════
         5 · ABOUT (Stagioni + personale + interessi + formazione)
         ════════════════════════════════════════════════════════ -->
    <section class="section" id="about" aria-labelledby="about-title">
      <div class="wrap">
        <ChapterHero
          eyebrow="CHI SONO"
          title="Mi chiamo Patrizia Gardis."
          size="96"
        />
        <div class="about__intro">
          <div>
            <p class="prose reveal">
              Lavoro nel settore IT da oltre sette anni. Sono
              <strong class="strong">donna, madre, professionista e
              imprenditrice</strong>, ma il mio percorso principale nasce nella
              <em class="accent">Database Administration</em> e nelle
              infrastrutture IT.
            </p>
            <p class="prose reveal">
              Sono cresciuta attraverso progetti sempre più complessi:
              dall'operatività quotidiana alla progettazione di soluzioni
              infrastrutturali, al consolidamento di ambienti enterprise e alla
              collaborazione con team multidisciplinari. Metodo, responsabilità
              e attenzione ai dettagli sono il filo che tiene insieme ogni
              esperienza.
            </p>
          </div>
          <div class="about__media reveal">
            <img
              src="/patrizia-ritratto.jpg"
              alt="Ritratto di Patrizia Gardis"
              width="1024"
              height="1536"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>

      <!-- Stagioni -->
      <div class="wrap subhead reveal">
        <span class="chapter__eyebrow">IL PERCORSO</span>
        <h3 class="subhead__title">Le stagioni di Patrizia</h3>
      </div>
      <div class="seasons">
        <div class="seasons__bg" aria-hidden="true"></div>
        <div class="seasons__content wrap seasons__grid">
          {
            stagioni.map((s) => (
              <article class="season reveal">
                <span class="season__name">{s.season}</span>
                <h3 class="season__key">{s.key}</h3>
                <p class="season__body">{s.body}</p>
              </article>
            ))
          }
        </div>
      </div>

      <!-- Approfondimenti comprimibili -->
      <div class="wrap disc-group">
        <details class="disc reveal">
          <summary class="disc__summary">
            <span class="disc__head">
              <span class="chapter__eyebrow">IL PERCORSO</span>
              <span class="disc__title">Il punto di svolta</span>
            </span>
            <span class="disc__icon" aria-hidden="true"></span>
          </summary>
          <div class="disc__content">
            <blockquote class="svolta__quote">
              Anche le prove più difficili possono trasformarsi in occasioni di
              crescita.
            </blockquote>
            <p class="prose">
              Circa un anno fa la mia carriera ha attraversato un cambiamento
              importante. Quello che sembrava un momento di incertezza è
              diventato un'opportunità: ampliare le competenze, evolvere verso
              progettazione e responsabilità, e iniziare a costruire nuovi
              progetti, dalla nascita di PGNetwork allo sviluppo di un mio
              network professionale.
            </p>
          </div>
        </details>

        <details class="disc reveal">
          <summary class="disc__summary">
            <span class="disc__head">
              <span class="chapter__eyebrow">VITA PRIVATA</span>
              <span class="disc__title">Famiglia, passioni e missione</span>
            </span>
            <span class="disc__icon" aria-hidden="true"></span>
          </summary>
          <div class="disc__content">
            <div class="personal">
              <div class="personal__block">
                <span class="chapter__eyebrow">FAMIGLIA</span>
                <p class="personal__line">
                  Tre figli: Nicole, Loris e Nicolas. La famiglia è una delle
                  mie motivazioni più grandi e mi ricorda ogni giorno perché
                  vale la pena crescere, studiare e costruire.
                </p>
              </div>
              <div class="personal__block">
                <span class="chapter__eyebrow">PASSIONI</span>
                <ul class="keywords keywords--soft" role="list">
                  <li>Danza</li>
                  <li>Canto</li>
                  <li>Viaggi</li>
                  <li>Fotografia</li>
                  <li>Moda</li>
                </ul>
                <p class="personal__line personal__line--sm">
                  Passioni che mi danno energia ed equilibrio. Di recente anche
                  un percorso come modella presso Identity Agency di Milano.
                </p>
              </div>
              <div class="personal__block">
                <span class="chapter__eyebrow">MISSIONE</span>
                <p class="personal__line">
                  Un giorno, una scuola a Santo Domingo, il mio Paese d'origine,
                  per offrire ai giovani più possibilità di formazione e futuro.
                  Sostengo cause legate all'infanzia e all'educazione.
                </p>
              </div>
            </div>
          </div>
        </details>

        <details class="disc reveal">
          <summary class="disc__summary">
            <span class="disc__head">
              <span class="chapter__eyebrow">OLTRE LA TECNOLOGIA</span>
              <span class="disc__title">Progetti &amp; Interessi</span>
            </span>
            <span class="disc__icon" aria-hidden="true"></span>
          </summary>
          <div class="disc__content">
            <div class="cards">
              {
                interessi.map((r) => (
                  <article class="card">
                    <span class="card__meta">{r.meta}</span>
                    <h4 class="card__title">{r.title}</h4>
                    <p class="card__desc">{r.desc}</p>
                    {r.href && (
                      <a
                        class="card__cta"
                        href={r.href}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {r.cta} <span aria-hidden="true">→</span>
                      </a>
                    )}
                  </article>
                ))
              }
            </div>
          </div>
        </details>

        <details class="disc reveal">
          <summary class="disc__summary">
            <span class="disc__head">
              <span class="chapter__eyebrow">FORMAZIONE</span>
              <span class="disc__title">Quattro aree di crescita</span>
            </span>
            <span class="disc__icon" aria-hidden="true"></span>
          </summary>
          <div class="disc__content">
            <div class="formgrid">
              {
                formazione.map((f) => (
                  <article class="formcat">
                    <h4 class="formcat__cat">{f.cat}</h4>
                    <p class="formcat__desc">{f.desc}</p>
                    <ul class="formcat__refs" role="list">
                      {f.refs.map((r) => <li>{r}</li>)}
                    </ul>
                  </article>
                ))
              }
            </div>
            <p class="fineprint">
              I percorsi e i professionisti citati sono seguiti a titolo
              formativo e non implicano partnership o endorsement. I contenuti
              hanno finalità narrative e formative e non costituiscono consulenza
              finanziaria o raccomandazioni di investimento. Il trading comporta
              rischio di perdita del capitale.
            </p>
          </div>
        </details>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════
         6 · JOURNAL · Approfondimenti
         ════════════════════════════════════════════════════════ -->
    <section class="section" id="journal" aria-labelledby="journal-title">
      <div class="wrap">
        <ChapterHero eyebrow="JOURNAL" title="Approfondimenti" size="72" />
        <p class="prose prose--lead reveal">
          Contenuti divulgativi su database, continuità operativa e innovazione.
        </p>
        <p class="prose reveal">
          Condivido ciò che imparo su temi chiave come il ruolo di un DBA, le
          metriche del Disaster Recovery (RTO e RPO), l'assessment delle
          infrastrutture e l'esplorazione di nuove tecnologie e criptovalute.
        </p>
      </div>
      <div class="wrap journal__grid">
        {
          journal.map((p) => (
            <PosterImage
              src={p.src}
              alt={p.alt}
              w={p.w}
              h={p.h}
              max="24rem"
              caption={p.caption}
            />
          ))
        }
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════
         7 · CONTATTI
         ════════════════════════════════════════════════════════ -->
    <section class="cta" id="contatti" aria-labelledby="cta-title">
      <div class="cta__card reveal">
        <div class="cta__head">
          <span>PGNETWORK</span>
          <span>DATABASE &amp; INFRASTRUCTURE</span>
        </div>

        <h2 id="cta-title" class="cta__title">Entriamo in contatto.</h2>
        <p class="cta__lead">
          Se il mio profilo è utile per un progetto in ambito Database &amp;
          Infrastructure, scriviamoci.
        </p>

        <ul class="contact-list" role="list">
          <li>
            <span class="contact-list__label">Email</span>
            <a href="mailto:pgardis@pgnetwork.it">pgardis@pgnetwork.it</a>
          </li>
          <li>
            <span class="contact-list__label">Telefono</span>
            <a href="tel:+393518108858">+39 351 810 8858</a>
          </li>
          <li>
            <span class="contact-list__label">PGNetwork</span>
            <span class="contact-list__soft">Sito in costruzione</span>
          </li>
        </ul>

        <form
          class="form"
          novalidate
          action="mailto:pgardis@pgnetwork.it"
          method="post"
          enctype="text/plain"
        >
          <div class="field">
            <label class="field__label" for="nome">Nome</label>
            <input
              class="field__input"
              type="text"
              id="nome"
              name="nome"
              autocomplete="name"
              placeholder="Il tuo nome"
            />
          </div>
          <div class="field">
            <label class="field__label" for="email">Email</label>
            <input
              class="field__input"
              type="email"
              id="email"
              name="email"
              autocomplete="email"
              placeholder="La tua email"
            />
          </div>
          <div class="field">
            <label class="field__label" for="messaggio">Messaggio</label>
            <textarea
              class="field__input field__textarea"
              id="messaggio"
              name="messaggio"
              rows="4"
              placeholder="Raccontami in breve"></textarea>
          </div>

          <label class="consent">
            <input type="checkbox" name="consenso" required />
            <span>
              Ho letto e accetto la
              <a href="/privacy">Privacy Policy</a> e autorizzo il trattamento
              dei miei dati per rispondere alla richiesta.
            </span>
          </label>

