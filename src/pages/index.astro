  "SQL Server",
  "PostgreSQL",
  "MongoDB",
  "Db2",
  "Linux",
];

const competenze = [
  {
    num: "01",
    title: "Database Administration",
    items: [
      "Oracle Database 12c / 18c / 19c",
      "Microsoft SQL Server",
      "PostgreSQL",
      "MongoDB",
      "IBM Db2",
      "MySQL / MariaDB",
    ],
  },
  {
    num: "02",
    title: "Oracle & Enterprise",
    items: [
      "RMAN / RMAN Duplicate",
      "Data Pump (expdp / impdp)",
      "Database Link, Scheduler, Network ACL",
      "Oracle Security, CMU, Wallet",
      "Active Directory / LDAP / Kerberos",
      "Unified Auditing, WebLogic",
      "JDBC, Oracle Net / TNS, Listener",
    ],
  },
  {
    num: "03",
    title: "Migration & Consolidation",
    items: [
      "Database Migration",
      "Production / Pre-Production Refresh",
      "Database Consolidation",
      "Backup & Restore",
      "Assessment infrastrutturali",
      "Validazione post-migrazione",
      "Troubleshooting",
    ],
  },
  {
    num: "04",
    title: "Infrastructure",
    items: [
      "Linux / Red Hat / CentOS",
      "IBM AIX",
      "Bash / Shell scripting",
      "Networking / DNS",
      "Monitoring",
      "Technical Documentation",
      "Runbook / Confluence",
    ],
  },
];

const flusso = [
  { k: "Assessment", d: "Analisi ambiente e criticità" },
  { k: "Planning", d: "Strategia e piano operativo" },
  { k: "Migration / Refresh", d: "Migrazione e riallineamento" },
  { k: "Validation", d: "Collaudo e verifica qualità" },
  { k: "Documentation", d: "Runbook e knowledge base" },
  { k: "Support", d: "Continuità e handover" },
];

const stagioni = [
  {
    season: "Inverno",
    key: "Cambiamento",
    body: "Il momento in cui qualcosa si interrompe e bisogna ridefinire la propria direzione.",
  },
  {
    season: "Primavera",
    key: "Crescita",
    body: "Studio, formazione, nuove competenze e nuovi progetti.",
  },
  {
    season: "Estate",
    key: "Costruzione",
    body: "Progetti enterprise, collaborazioni, responsabilità, team e nascita di PGNetwork.",
  },
  {
    season: "Autunno",
    key: "Raccolto e condivisione",
    body: "Restituire ciò che ho imparato attraverso formazione, mentoring, network e nuove opportunità per altre persone.",
  },
