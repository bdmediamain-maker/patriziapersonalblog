---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import ChapterHero from "../components/ChapterHero.astro";

// Posizioni aperte
const posizioni = [
  {
    ruolo: "GIS Developer",
    posti: "3 posizioni",
    claim:
      "Unisciti al nostro team e contribuisci a progetti ad alto impatto nel mondo GIS.",
    meta: [
      { k: "Esperienza", v: "Almeno 3 anni in ambito GIS / Geospatial" },
      { k: "Livello", v: "Middle" },
      { k: "Tariffa", v: "Da definire (si valutano diversi livelli)" },
      { k: "Modalità", v: "Full remote" },
      { k: "Distacco", v: "Sì, previsto" },
    ],
    competenze: [
      "Laurea in Informatica, Ingegneria Informatica o discipline affini",
      "Python per l'elaborazione di dati geografici",
      "GeoServer, Oracle Spatial e FME",
      "Java 11+ e Spring Boot",
      "Sviluppo di microservizi",
      "API REST e servizi SOAP",
      "Buona conoscenza di SQL",
      "Angular 9+",
      "Git / GitLab e metodologie Agile / Scrum",
    ],
  },
];
---

<Base title="Collabora con noi · PGNetwork | Entra nel Network">
  <Nav />

  <main class="page">
    <!-- Intro -->
    <section class="section">
      <div class="wrap">
        <ChapterHero
          eyebrow="COLLABORA CON NOI"
          title="Costruiamo il network insieme."
          size="96"
        />
        <p class="lead">
          Che tu stia cercando una nuova opportunità o voglia mettere le tue
          competenze al servizio di nuovi progetti, puoi entrare in PGNetwork:
          una rete di professionisti, consulenti e specialisti che condividono
          competenze, esperienza e visione.
        </p>

        <div class="paths" data-stagger>
          <a class="path" href="#posizioni" data-tilt>
            <span class="path__eyebrow">POSIZIONI APERTE</span>
            <span class="path__title">Cerchi una nuova opportunità?</span>
            <span class="path__cta">Invia il tuo CV</span>
          </a>
          <a class="path" href="#team" data-tilt>
            <span class="path__eyebrow">ENTRA NEL TEAM</span>
            <span class="path__title">Vuoi collaborare con noi?</span>
            <span class="path__cta">Candidati al Team</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Posizioni aperte -->
    <section class="section band" id="posizioni">
      <div class="wrap">
        <span class="chapter__eyebrow gold">POSIZIONI APERTE</span>
        <h2 class="h2">Le ricerche attive</h2>

        {
          posizioni.map((p) => (
            <article class="pos">
              <div class="pos__head">
                <div>
                  <span class="pos__posti">{p.posti}</span>
                  <h3 class="pos__ruolo">{p.ruolo}</h3>
                  <p class="pos__claim">{p.claim}</p>
                </div>
                <a class="btn" href="#form-cv">
                  Invia il tuo CV
                </a>
              </div>
              <div class="pos__grid">
                <ul class="pos__meta" role="list">
                  {p.meta.map((m) => (
                    <li>
                      <span class="pos__k">{m.k}</span>
                      <span class="pos__v">{m.v}</span>
                    </li>
                  ))}
                </ul>
                <div class="pos__skills">
                  <span class="pos__skills-lab">Competenze e tecnologie</span>
                  <ul role="list">
                    {p.competenze.map((c) => (
                      <li>{c}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Form: Invia il tuo CV -->
    <section class="section" id="form-cv">
      <div class="wrap wrap--form">
        <span class="chapter__eyebrow gold">AGGIUNGI IL TUO CV</span>
        <h2 class="h2">Invia il tuo profilo</h2>
        <p class="lead lead--sm">
          Vuoi entrare nel network PGNetwork? Inviaci il tuo profilo: potresti
          essere contattato per una delle nostre posizioni aperte o per future
          opportunità di collaborazione.
        </p>

        <form class="form" data-pgform data-tipo="candidatura-cv" novalidate>
          <div class="form__grid">
            <label class="field">
              <span class="field__label">Nome e cognome *</span>
              <input class="field__input" type="text" name="nome_cognome" required autocomplete="name" />
            </label>
            <label class="field">
              <span class="field__label">Email *</span>
              <input class="field__input" type="email" name="email" required autocomplete="email" />
            </label>
            <label class="field">
              <span class="field__label">Ruolo / specializzazione</span>
              <input class="field__input" type="text" name="ruolo" />
            </label>
            <label class="field">
              <span class="field__label">Anni di esperienza</span>
              <input class="field__input" type="text" name="esperienza" inputmode="numeric" />
            </label>
            <label class="field field--full">
              <span class="field__label">Tecnologie / competenze</span>
              <textarea class="field__input field__textarea" name="competenze" rows="3"></textarea>
            </label>
            <label class="field">
              <span class="field__label">Disponibilità</span>
              <input class="field__input" type="text" name="disponibilita" placeholder="Es. immediata, 30 giorni" />
            </label>
            <label class="field">
              <span class="field__label">LinkedIn</span>
              <input class="field__input" type="url" name="linkedin" placeholder="https://" />
            </label>
            <label class="field field--full">
              <span class="field__label">Partita IVA / tipologia di collaborazione</span>
              <input class="field__input" type="text" name="collaborazione" placeholder="Es. P.IVA, dipendente, freelance" />
            </label>
            <label class="field field--full field--file">
              <span class="field__label">CV (PDF o Word, max 8 MB)</span>
              <input class="field__file" type="file" name="cv" accept=".pdf,.doc,.docx,application/pdf" />
            </label>
          </div>

          <label class="consent">
            <input type="checkbox" name="consenso" required />
            <span>
              Ho letto la <a href="/privacy">Privacy Policy</a> e autorizzo il
              trattamento dei miei dati per la candidatura.
            </span>
          </label>

          <button class="form__submit" type="submit">Invia il tuo CV</button>
        </form>
      </div>
    </section>

    <!-- Form: Entra nel Team -->
    <section class="section band" id="team">
      <div class="wrap wrap--form">
        <span class="chapter__eyebrow gold">ENTRA NEL TEAM</span>
        <h2 class="h2">Aggiungi il tuo talento al nostro Team</h2>
        <p class="lead lead--sm">
          PGNetwork è una rete di professionisti che condividono competenze,
          esperienza e visione. Se pensi di poter portare valore nel nostro
          network, raccontaci chi sei e cosa sai fare.
        </p>

        <form class="form" data-pgform data-tipo="candidatura-team" novalidate>
          <div class="form__grid">
            <label class="field">
              <span class="field__label">Nome e cognome *</span>
              <input class="field__input" type="text" name="nome_cognome" required autocomplete="name" />
            </label>
            <label class="field">
              <span class="field__label">Email *</span>
              <input class="field__input" type="email" name="email" required autocomplete="email" />
            </label>
            <label class="field">
              <span class="field__label">Ruolo</span>
              <input class="field__input" type="text" name="ruolo" />
            </label>
            <label class="field">
              <span class="field__label">Specializzazione</span>
              <input class="field__input" type="text" name="specializzazione" />
            </label>
            <label class="field field--full">
              <span class="field__label">Bio breve</span>
              <textarea class="field__input field__textarea" name="bio" rows="3"></textarea>
            </label>
            <label class="field field--full">
              <span class="field__label">Competenze</span>
              <textarea class="field__input field__textarea" name="competenze" rows="2"></textarea>
            </label>
            <label class="field">
              <span class="field__label">Tecnologie</span>
              <input class="field__input" type="text" name="tecnologie" />
            </label>
            <label class="field">
              <span class="field__label">LinkedIn</span>
              <input class="field__input" type="url" name="linkedin" placeholder="https://" />
            </label>
            <label class="field">
              <span class="field__label">Disponibilità a collaborare</span>
              <input class="field__input" type="text" name="disponibilita" />
            </label>
            <label class="field field--file">
              <span class="field__label">Foto (immagine, max 8 MB)</span>
              <input class="field__file" type="file" name="foto" accept="image/*" />
            </label>
            <label class="field field--full field--file">
              <span class="field__label">CV (PDF o Word, max 8 MB)</span>
              <input class="field__file" type="file" name="cv" accept=".pdf,.doc,.docx,application/pdf" />
            </label>
          </div>

          <label class="consent">
            <input type="checkbox" name="consenso" required />
            <span>
              Ho letto la <a href="/privacy">Privacy Policy</a> e autorizzo il
              trattamento dei miei dati per la candidatura.
            </span>
          </label>

          <button class="form__submit" type="submit">Candidati al Team</button>
        </form>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<script>
  import { initForms } from "../lib/forms";
  initForms();
</script>

<style>
  .page {
    padding-top: clamp(4.5rem, 10vh, 7rem);
  }
  .wrap {
    max-width: 72rem;
    margin: 0 auto;
    padding-inline: clamp(1.25rem, 5vw, 4rem);
  }
  .wrap--form {
    max-width: 56rem;
  }
  .section {
    padding-block: clamp(2.25rem, 4.5vw, 3.5rem);
  }
  .band {
    background: var(--navy);
    border-block: 1px solid var(--rule);
  }
  .lead {
    margin: 1.5rem 0 0;
    max-width: 62ch;
    font-family: var(--font-sans);
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.65;
    color: var(--muted);
  }
  .lead--sm {
    font-size: clamp(1rem, 1.4vw, 1.1rem);
    margin-top: 1rem;
  }
  .chapter__eyebrow {
    margin: 0;
    font-family: var(--font-label);
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--muted);
  }
  .chapter__eyebrow.gold {
    color: var(--gold);
  }
  .h2 {
    margin: 0.8rem 0 0;
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: clamp(1.8rem, 3.6vw, 2.75rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: var(--paper);
  }

  /* Path cards */
  .paths {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }
  .path {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(1.6rem, 3.5vw, 2.25rem);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.02);
    text-decoration: none;
    transition:
      border-color 300ms ease,
      background-color 300ms ease,
      translate 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .path:hover {
    border-color: rgba(230, 169, 46, 0.45);
    background: rgba(230, 169, 46, 0.04);
  }
  .path__eyebrow {
    font-family: var(--font-label);
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--gold);
  }
  .path__title {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: clamp(1.3rem, 2.2vw, 1.7rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--paper);
  }
  .path__cta {
    margin-top: 0.4rem;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 13px;
    color: var(--gold);
  }

  /* Posizione */
  .pos {
    margin-top: clamp(2rem, 4vw, 3rem);
    padding: clamp(1.5rem, 3.5vw, 2.25rem);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.02);
  }
  .pos__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .pos__posti {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    color: var(--gold);
  }
  .pos__ruolo {
    margin: 0.5rem 0 0.6rem;
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: clamp(1.6rem, 3vw, 2.3rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: var(--paper);
  }
  .pos__claim {
    margin: 0;
    max-width: 42ch;
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--muted);
  }
  .pos__grid {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .pos__meta {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .pos__meta li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    border-top: 1px solid var(--rule);
    padding-top: 0.7rem;
  }
  .pos__k {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--gold);
  }
  .pos__v {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: 0.95rem;
    color: var(--paper);
  }
  .pos__skills-lab {
    display: block;
    margin-bottom: 0.9rem;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--gold);
  }
  .pos__skills ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }
  .pos__skills li {
    position: relative;
    padding-left: 1.2rem;
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: 0.95rem;
    line-height: 1.45;
    color: rgba(236, 235, 231, 0.85);
  }
  .pos__skills li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold);
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.9rem 1.5rem;
    border-radius: 999px;
    background: var(--gold);
    color: var(--canvas);
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: background-color 250ms ease;
  }
  .btn:hover {
    background: #f0bd52;
  }

  /* Form */
  .form {
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .form__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .field--full {
    grid-column: 1 / -1;
  }
  .field__label {
    font-family: var(--font-label);
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
  }
  .field__input {
    appearance: none;
    width: 100%;
    padding: 0.75rem 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 0.65rem;
    background: rgba(10, 10, 12, 0.6);
    font-family: var(--font-sans);
    font-size: 0.98rem;
    color: var(--paper);
    transition: border-color 250ms ease;
  }
  .field__input:focus {
    outline: none;
    border-color: var(--gold);
  }
  .field__textarea {
    resize: vertical;
    min-height: 4.5rem;
    line-height: 1.6;
  }
  .field__file {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--muted);
    padding: 0.5rem 0;
  }
  .field__file::file-selector-button {
    margin-right: 1rem;
    padding: 0.55rem 1.1rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    background: transparent;
    color: var(--paper);
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 12px;
    cursor: pointer;
    transition: border-color 250ms ease;
  }
  .field__file::file-selector-button:hover {
    border-color: var(--gold);
    color: var(--gold);
  }
  .consent {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-top: 1.75rem;
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: 13px;
    line-height: 1.55;
    color: var(--muted);
  }
  .consent input {
    margin-top: 0.2rem;
    accent-color: var(--gold);
    flex: 0 0 auto;
  }
  .consent a {
    color: var(--paper);
    text-underline-offset: 3px;
  }
  .consent a:hover {
    color: var(--gold);
  }
  .form__submit {
    appearance: none;
    margin-top: 1.75rem;
    padding: 1rem 1.75rem;
    border: none;
    border-radius: 999px;
    background: var(--gold);
    color: var(--canvas);
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition: background-color 250ms ease;
  }
  .form__submit:hover {
    background: #f0bd52;
  }
  .form__submit:disabled {
    opacity: 0.6;
    cursor: default;
  }
  /* Creato via JS (forms.ts): serve :global perché non ha l'attributo di scope */
  .form :global(.form-status) {
    margin: 1.25rem 0 0;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .form :global(.form-status[data-state="ok"]) {
    color: var(--gold);
  }
  .form :global(.form-status[data-state="err"]) {
    color: #f08a8a;
  }

  @media (max-width: 800px) {
    .paths,
    .pos__grid,
    .form__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
