---
import "../styles/global.css";
import GrainOverlay from "../components/GrainOverlay.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "PGNetwork · Servizi IT B2B: software, database, cloud e sicurezza",
  description = "PGNetwork è un network B2B di professionisti IT: sviluppo software, database, cloud, infrastrutture, cybersecurity e disaster recovery. Fondato da Patrizia Gardis, Database & Infrastructure Consultant.",
} = Astro.props;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="mask-icon" href="/favicon.svg" color="#e6a92e" />
    <meta name="theme-color" content="#0a0a0c" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph (text-only draft) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="it_IT" />

    <!-- Fonts: Inter (testo/titoli) + Plus Jakarta Sans (etichette) + Instrument Serif (accenti) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300..800&family=Plus+Jakarta+Sans:wght@500..800&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body id="top">
    <GrainOverlay />
    <slot />

    <!-- Lightbox: ingrandimento locandine -->
    <div class="lightbox" data-lightbox hidden aria-hidden="true">
      <button
        type="button"
        class="lightbox__close"
        data-lightbox-close
        aria-label="Chiudi"
      >
        &times;
      </button>
      <img class="lightbox__img" data-lightbox-img alt="" />
    </div>

    <script>
      // Scroll-reveal: fade + translate-Y on intersection.
      // Respects prefers-reduced-motion (handled in CSS: elements are
      // already visible there, so the observer simply has nothing to do).
      const setup = () => {
        // Le card dentro [data-stagger] entrano una dopo l'altra
        document.querySelectorAll<HTMLElement>("[data-stagger]").forEach((group) => {
          Array.from(group.children).forEach((child) => {
            child.classList.add("reveal");
            (child as HTMLElement).dataset.staggerChild = "";
          });
        });

        const els = document.querySelectorAll<HTMLElement>(".reveal");
        if (!("IntersectionObserver" in window) || els.length === 0) {
          els.forEach((el) => el.classList.add("is-visible"));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            // Ritardo crescente solo tra le card che entrano nello stesso momento
            let n = 0;
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;
              if (el.dataset.staggerChild !== undefined) {
                el.style.setProperty("--reveal-delay", `${n++ * 90}ms`);
              }
              el.classList.add("is-visible");
              io.unobserve(el);
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
        );
        els.forEach((el) => io.observe(el));
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", setup);
      } else {
        setup();
      }
    </script>

    <script>
      // Inclinazione 3D delle card che segue il cursore (solo mouse/trackpad).
      const canTilt =
        window.matchMedia("(hover: hover) and (pointer: fine)").matches &&
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (canTilt) {
        document.querySelectorAll<HTMLElement>("[data-tilt]").forEach((el) => {
          el.addEventListener("pointermove", (e) => {
            const r = el.getBoundingClientRect();
            const px = (e.clientX - r.left) / r.width - 0.5;
            const py = (e.clientY - r.top) / r.height - 0.5;
            el.style.setProperty("--rx", `${(-py * 6).toFixed(2)}deg`);
            el.style.setProperty("--ry", `${(px * 7).toFixed(2)}deg`);
          });
          el.addEventListener("pointerleave", () => {
            el.style.setProperty("--rx", "0deg");
            el.style.setProperty("--ry", "0deg");
          });
        });
      }
    </script>

    <script>
      // Lightbox: apre la locandina a schermo intero per leggerne il contenuto.
      (function () {
        const lb = document.querySelector<HTMLElement>("[data-lightbox]");
        if (!lb) return;
        const lbImg = lb.querySelector<HTMLImageElement>("[data-lightbox-img]");
        if (!lbImg) return;

        const open = (src: string, alt: string) => {
          lbImg.src = src;
          lbImg.alt = alt;
          lb.hidden = false;
          lb.setAttribute("aria-hidden", "false");
          document.body.style.overflow = "hidden";
        };
        const close = () => {
          lb.hidden = true;
          lb.setAttribute("aria-hidden", "true");
          lbImg.removeAttribute("src");
          document.body.style.overflow = "";
        };

        document.querySelectorAll<HTMLElement>("[data-zoom]").forEach((btn) => {
          btn.addEventListener("click", () => {
            // Sorgente esplicita (es. pulsanti testuali) oppure l'immagine interna
            if (btn.dataset.zoomSrc) {
              open(btn.dataset.zoomSrc, btn.dataset.zoomAlt || "");
              return;
            }
            const img = btn.querySelector("img");
            if (img) open(img.currentSrc || img.src, img.alt);
          });
        });

        lb.addEventListener("click", (e) => {
          const t = e.target as HTMLElement;
          if (t === lb || t.hasAttribute("data-lightbox-close")) close();
        });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && !lb.hidden) close();
        });
      })();
    </script>

    <style>
      .lightbox {
        position: fixed;
        inset: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: clamp(1rem, 4vw, 3rem);
        background: rgba(6, 6, 8, 0.92);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
        cursor: zoom-out;
        animation: lb-fade 260ms ease;
      }
      .lightbox[hidden] {
        display: none;
      }
      .lightbox__img {
        max-width: 92vw;
        max-height: 90vh;
        width: auto;
        height: auto;
        border-radius: 4px;
        box-shadow: 0 30px 90px -20px rgba(0, 0, 0, 0.9);
        cursor: default;
      }
      .lightbox__close {
        position: fixed;
        top: 1rem;
        right: 1.25rem;
        width: 2.75rem;
        height: 2.75rem;
        display: grid;
        place-items: center;
        border: none;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.12);
        color: #fff;
        font-size: 1.7rem;
        line-height: 1;
        cursor: pointer;
        transition: background-color 300ms ease;
      }
      .lightbox__close:hover {
        background: rgba(255, 255, 255, 0.22);
      }
      @keyframes lb-fade {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .lightbox {
          animation: none;
        }
      }
    </style>
  </body>
</html>
