---
/**
 * Nav: header fisso.
 * Desktop: logo + link in linea + CTA contatti.
 * Mobile/tablet: hamburger che apre un overlay scuro a tutto schermo.
 * Allo scroll l'header prende uno sfondo sfocato per restare leggibile.
 */
const principali = [
  { href: "/servizi", name: "Servizi" },
  { href: "/#pgnetwork", name: "PGNetwork" },
  { href: "/#chi-sono", name: "Chi sono" },
  { href: "/#journal", name: "Journal" },
  { href: "/collabora", name: "Collabora" },
];

const tutte = [
  { href: "/", name: "Home" },
  { href: "/#pgnetwork", name: "PGNetwork" },
  { href: "/servizi", name: "Servizi" },
  { href: "/#chi-sono", name: "Chi sono" },
  { href: "/#competenze", name: "Competenze" },
  { href: "/#journal", name: "Journal" },
  { href: "/#percorso", name: "Il percorso" },
  { href: "/collabora", name: "Collabora" },
  { href: "/#contatti", name: "Contatti" },
];
---

<header class="nav" data-nav-header>
  <nav class="nav__inner" aria-label="Navigazione principale">
    <a href="/" class="nav__brand" aria-label="PGNetwork, home">
      <span class="nav__mark" aria-hidden="true">PG</span>
      <span class="nav__words">
        <span class="nav__name">PGNETWORK</span>
        <span class="nav__sub">PATRIZIA GARDIS</span>
      </span>
    </a>

    <ul class="nav__links" role="list">
      {
        principali.map((l) => (
          <li>
            <a class="nav__link" href={l.href}>
              {l.name}
            </a>
          </li>
        ))
      }
    </ul>

    <a class="nav__cta" href="/#contatti">Contatti</a>

    <button
      type="button"
      class="nav__toggle"
      id="menu-toggle"
      aria-expanded="false"
      aria-controls="site-menu"
      aria-label="Apri il menu"
    >
      <svg class="nav__icon nav__icon--open" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <svg class="nav__icon nav__icon--close" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12" />
      </svg>
    </button>
  </nav>
</header>

<div class="menu" id="site-menu" data-menu>
  <nav class="menu__panel" aria-label="Menu sezioni">
    <ol class="menu__list">
      {
        tutte.map((s, i) => (
          <li class="menu__item" style={`--i:${i}`}>
            <a class="menu__link" href={s.href} data-nav>
              <span class="menu__name">{s.name}</span>
            </a>
          </li>
        ))
      }
    </ol>
    <div class="menu__foot">
      <a href="mailto:pgardis@pgnetwork.it">pgardis@pgnetwork.it</a>
      <a href="tel:+393518108858">+39 351 810 8858</a>
    </div>
  </nav>
</div>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    transition:
      background-color 400ms ease,
      border-color 400ms ease,
      backdrop-filter 400ms ease;
    border-bottom: 1px solid transparent;
  }
  .nav.is-scrolled {
    background: rgba(10, 10, 12, 0.72);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom-color: rgba(255, 255, 255, 0.06);
  }
  .nav__inner {
    max-width: 90rem;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 1.1rem clamp(1.25rem, 5vw, 4rem);
  }

  /* Logo */
  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: #ffffff;
    margin-right: auto;
  }
  .nav__mark {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border: 1px solid rgba(255, 255, 255, 0.85);
    border-radius: 0.5rem;
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 0.8rem;
    letter-spacing: -0.02em;
    color: #ffffff;
  }
  .nav__words {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .nav__name {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 15px;
    line-height: 1;
    letter-spacing: 0.08em;
  }
  .nav__sub {
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 9.5px;
    line-height: 1;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.55);
  }

  /* Link desktop */
  .nav__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.2vw, 2.25rem);
  }
  .nav__link {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 15px;
    color: rgba(255, 255, 255, 0.86);
    text-decoration: none;
    transition: color 250ms ease;
  }
  .nav__link:hover,
  .nav__link:focus-visible {
    color: var(--gold);
  }
  .nav__cta {
    padding: 0.6rem 1.2rem;
    border: 1px solid rgba(230, 169, 46, 0.55);
    border-radius: 999px;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 13px;
    color: var(--gold);
    text-decoration: none;
    transition:
      background-color 250ms ease,
      color 250ms ease;
  }
  .nav__cta:hover {
    background: var(--gold);
    color: var(--canvas);
  }

  /* Hamburger (solo mobile/tablet) */
  .nav__toggle {
    display: none;
    width: 2.6rem;
    height: 2.6rem;
    place-items: center;
    padding: 0;
    margin: 0;
    background: none;
    border: none;
    cursor: pointer;
    color: #ffffff;
  }
  .nav__icon {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  .nav__icon--close {
    display: none;
  }
  .nav__toggle[aria-expanded="true"] .nav__icon--open {
    display: none;
  }
  .nav__toggle[aria-expanded="true"] .nav__icon--close {
    display: block;
  }

  /* Overlay a tutto schermo */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 55;
    visibility: hidden;
    pointer-events: none;
  }
  .menu.is-open {
    visibility: visible;
    pointer-events: auto;
  }
  .menu__panel {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: clamp(6rem, 14vh, 8rem) clamp(1.5rem, 6vw, 3.5rem) 2.5rem;
    background: #0a0a0c;
    overflow-y: auto;
    overscroll-behavior: contain;
    opacity: 0;
    transition: opacity 380ms ease;
  }
  .menu.is-open .menu__panel {
    opacity: 1;
  }
  .menu__list {
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
  }
  .menu__item {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 420ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .menu.is-open .menu__item {
    opacity: 1;
    transform: translateY(0);
    transition-delay: calc(120ms + var(--i) * 40ms);
  }
  .menu__link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.7rem 0;
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }
  .menu__name {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: clamp(1.6rem, 6vw, 2.25rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--paper);
    transition: color 250ms ease;
  }
  .menu__link:hover .menu__name,
  .menu__link:focus-visible .menu__name {
    color: var(--gold);
  }
  .menu__foot {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .menu__foot a {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--muted);
    text-decoration: none;
  }
  .menu__foot a:hover {
    color: var(--gold);
  }

  @media (max-width: 1023px) {
    .nav__links,
    .nav__cta {
      display: none;
    }
    .nav__toggle {
      display: grid;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu__panel,
    .menu__item {
      transition: none;
    }
  }
</style>

<script>
  (function () {
    const header = document.querySelector<HTMLElement>("[data-nav-header]");
    const toggle = document.getElementById("menu-toggle");
    const menu = document.querySelector<HTMLElement>("[data-menu]");

    // Sfondo sfocato dopo i primi pixel di scroll
    if (header) {
      const onScroll = () =>
        header.classList.toggle("is-scrolled", window.scrollY > 24);
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
    }

    if (!toggle || !menu) return;
    const links = menu.querySelectorAll<HTMLAnchorElement>("[data-nav]");

    const open = () => {
      menu.classList.add("is-open");
      toggle.setAttribute("aria-expanded", "true");
      toggle.setAttribute("aria-label", "Chiudi il menu");
      document.body.style.overflow = "hidden";
    };
    const close = () => {
      menu.classList.remove("is-open");
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Apri il menu");
      document.body.style.overflow = "";
    };

    toggle.addEventListener("click", () => {
      menu.classList.contains("is-open") ? close() : open();
    });
    links.forEach((l) => l.addEventListener("click", close));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && menu.classList.contains("is-open")) close();
    });
  })();
</script>
