---
/**
 * Nav — sticky top navigation.
 * Transparent, no border. mix-blend-difference keeps it readable
 * across both the dark canvas and the light inverted sections.
 */
---

<header class="nav">
  <nav class="nav__inner" aria-label="Navigazione principale">
    <a href="#top" class="nav__brand">
      <span class="nav__name">PATRIZIA</span>
      <span class="nav__sub">PERSONAL JOURNAL — VOL. I</span>
    </a>
    <p class="nav__meta">MMXXVI / EDIZIONE LIMITATA</p>
  </nav>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 40;
    mix-blend-mode: difference;
    pointer-events: none;
  }
  .nav__inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem clamp(1.25rem, 5vw, 4rem);
  }
  .nav__brand {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    text-decoration: none;
    color: #ffffff;
    pointer-events: auto;
  }
  .nav__name {
    font-family: var(--font-serif);
    font-optical-sizing: auto;
    font-weight: 700;
    font-size: 20px;
    line-height: 1;
    letter-spacing: 0.01em;
  }
  .nav__sub {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    color: #ffffff;
  }
  .nav__meta {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    color: #ffffff;
    text-align: right;
    pointer-events: auto;
  }

  @media (max-width: 640px) {
    .nav__meta {
      display: none;
    }
  }
</style>
