---
/**
 * VerticalRow — one row of a vertical narrative list.
 * 12-col grid: 3 col title | 7 col description | 2 col meta.
 * Border-top 1px rule, hover tint + title shifts to accent.
 *
 * Props:
 *  - title:       row title (Fraunces italic)
 *  - description: row body (Manrope light)
 *  - meta:        right-aligned uppercase meta (e.g. "001 / TRE PROGETTI")
 */
interface Props {
  title: string;
  description: string;
  meta: string;
}

const { title, description, meta } = Astro.props;
---

<div class="row reveal">
  <h3 class="row__title">{title}</h3>
  <p class="row__desc">{description}</p>
  <p class="row__meta">{meta}</p>
</div>

<style>
  .row {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1.5rem;
    align-items: baseline;
    padding: 3rem 1.5rem;
    border-top: 1px solid var(--rule);
    transition: background-color 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .row:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  .row__title {
    grid-column: span 3;
    margin: 0;
    font-family: var(--font-serif);
    font-optical-sizing: auto;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.1;
    color: var(--paper);
    transition: color 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .row:hover .row__title {
    color: var(--accent);
  }

  .row__desc {
    grid-column: span 7;
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: clamp(1.125rem, 1.8vw, 1.5rem);
    line-height: 1.55;
    color: var(--paper);
  }

  .row__meta {
    grid-column: span 2;
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    color: var(--muted);
    text-align: right;
  }

  @media (max-width: 900px) {
    .row {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding: 2.25rem 0.5rem;
    }
    .row__title,
    .row__desc,
    .row__meta {
      grid-column: 1 / -1;
    }
    .row__meta {
      text-align: left;
    }
  }
</style>
