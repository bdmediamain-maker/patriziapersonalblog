---
/**
 * ChapterHero — reusable chapter label + section title block.
 *
 * Props:
 *  - eyebrow: small uppercase kicker (e.g. "CAPITOLO DUE — IL PRESENTE")
 *  - title:   section headline (Fraunces)
 *  - size:    headline size key — '60' | '72' | '96' (px target, fluid)
 *  - align:   'left' | 'center'
 *  - invert:  true on light sections (text becomes canvas color)
 */
interface Props {
  eyebrow?: string;
  title?: string;
  size?: "60" | "72" | "96";
  align?: "left" | "center";
  invert?: boolean;
}

const {
  eyebrow,
  title,
  size = "72",
  align = "left",
  invert = false,
} = Astro.props;
---

<div
  class:list={["chapter", `chapter--${align}`, { "chapter--invert": invert }]}
>
  {eyebrow && <p class="chapter__eyebrow reveal">{eyebrow}</p>}
  {
    title && (
      <h2 class:list={["chapter__title", `chapter__title--${size}`, "reveal"]}>
        {title}
      </h2>
    )
  }
</div>

<style>
  .chapter {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .chapter--center {
    align-items: center;
    text-align: center;
  }

  .chapter__eyebrow {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    color: var(--muted);
  }
  .chapter--invert .chapter__eyebrow {
    color: rgba(10, 10, 12, 0.55);
  }

  .chapter__title {
    margin: 0;
    font-family: var(--font-serif);
    font-optical-sizing: auto;
    font-weight: 300;
    line-height: 1.05;
    color: var(--paper);
    text-wrap: balance;
  }
  .chapter--invert .chapter__title {
    color: var(--canvas);
  }

  .chapter__title--60 {
    font-size: clamp(2.5rem, 6vw, 3.75rem);
  }
  .chapter__title--72 {
    font-size: clamp(2.75rem, 7vw, 4.5rem);
  }
  .chapter__title--96 {
    font-size: clamp(3rem, 9vw, 6rem);
  }
</style>
